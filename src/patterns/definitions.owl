AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ECTO_0000001> "radiation exposure")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ECTO_0000001> "exposure to radiation")
