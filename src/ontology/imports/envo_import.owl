AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PATO_0002323> "A temporal distribution pattern of process occurrences within a regulation/reference process.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PATO_0002323> "temporal distribution quality")
SubClassOf(<http://purl.obolibrary.org/obo/PATO_0002323> <http://purl.obolibrary.org/obo/PATO_0002062>)

# Class: <http://purl.obolibrary.org/obo/PATO_0002374> (fluctuating)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PATO_0002374> "Recurrent and often more or less cyclic alteration.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PATO_0002374> "fluctuating")
SubClassOf(<http://purl.obolibrary.org/obo/PATO_0002374> <http://purl.obolibrary.org/obo/PATO_0001227>)

# Class: <http://purl.obolibrary.org/obo/PATO_0015009> (humidity)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PATO_0015009> "A quality inhering in air by virtue of the partial pressure exerted by the bearer's water vapour content.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PATO_0015009> "humidity")
SubClassOf(<http://purl.obolibrary.org/obo/PATO_0015009> <http://purl.obolibrary.org/obo/PATO_0001547>)

# Class: <http://purl.obolibrary.org/obo/PATO_0015010> (increased humidity)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PATO_0015010> "An increase in humidity.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PATO_0015010> "increased humidity")
SubClassOf(<http://purl.obolibrary.org/obo/PATO_0015010> <http://purl.obolibrary.org/obo/PATO_0002305>)
SubClassOf(<http://purl.obolibrary.org/obo/PATO_0015010> <http://purl.obolibrary.org/obo/PATO_0015009>)

# Class: <http://purl.obolibrary.org/obo/PATO_0015021> (combustibility)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PATO_0015021> "The propensity of a material to undergo combustion. Combustion encompasses smouldering and flaming combustion. Combustibility is usually applied to solids.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PATO_0015021> "combustibility")
SubClassOf(<http://purl.obolibrary.org/obo/PATO_0015021> <http://purl.obolibrary.org/obo/PATO_0001018>)

# Class: <http://purl.obolibrary.org/obo/PATO_0015022> (increased combustibility)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PATO_0015022> "An increase in combustibility.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PATO_0015022> "combustible")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PATO_0015022> "increased combustibility")
SubClassOf(<http://purl.obolibrary.org/obo/PATO_0015022> <http://purl.obolibrary.org/obo/PATO_0002305>)
SubClassOf(<http://purl.obolibrary.org/obo/PATO_0015022> <http://purl.obolibrary.org/obo/PATO_0015021>)

# Class: <http://purl.obolibrary.org/obo/PATO_0040008> (fringed)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PATO_0040008> "A shape quality inhering in a bearer by virtue of the bearer's having an ornamental border consisting of short straight or twisted threads or strips hanging from cut or raveled edges or from a separate band.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PATO_0040008> "fringed")
SubClassOf(<http://purl.obolibrary.org/obo/PATO_0040008> <http://purl.obolibrary.org/obo/PATO_0002267>)

# Class: <http://purl.obolibrary.org/obo/PATO_0070060> (quality of interaction of a substance with electromagnetic radiation)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PATO_0070060> "A quality of a substance on which or through which electromagnetic radiation impinges or traverses with respect to radiation. This substance quality changes the quality of the incident radiation with respect to any of: intensity, direction, scatter and wavelength.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PATO_0070060> "quality of interaction of a substance with electromagnetic radiation")
SubClassOf(<http://purl.obolibrary.org/obo/PATO_0070060> <http://purl.obolibrary.org/obo/PATO_0002198>)

# Class: <http://purl.obolibrary.org/obo/PATO_0103000> (quantitative)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PATO_0103000> "A quality of an entity that can be represented numerically, including anything that can be counted, measured, or given a numerical value.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PATO_0103000> "quantitative")
SubClassOf(<http://purl.obolibrary.org/obo/PATO_0103000> <http://purl.obolibrary.org/obo/PATO_0000001>)

# Class: <http://purl.obolibrary.org/obo/PCO_0000000> (collection of organisms)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PCO_0000000> "A material entity that consists of two or more organisms, viruses, or viroids."@en)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PCO_0000000> "May be of the same or different species.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PCO_0000000> "collection of organisms"@en)
SubClassOf(<http://purl.obolibrary.org/obo/PCO_0000000> <http://purl.obolibrary.org/obo/BFO_0000040>)
SubClassOf(<http://purl.obolibrary.org/obo/PCO_0000000> <http://purl.obolibrary.org/obo/PCO_0000031>)

# Class: <http://purl.obolibrary.org/obo/PCO_0000001> (population of organisms)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PCO_0000001> "A collection of organisms, all of the same species, that live in the same place."@en)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PCO_0000001> "It is sometimes difficult to define the physical boundaries of a population. In the case of sexually reproducing organisms, the individuals within a population have the potential to reproduce with one another during the course of their lifetimes. 'Community', as often used to describe a group of humans, is a type of population of organisms. 

Classes for population already  exist in IDO ('organism population', IDO_0000509) and OBI ('population', OBI_0000181). The definitions should be standardized across OBO Foundry ontologies and only one term used."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PCO_0000001> "population of organisms"@en)
SubClassOf(<http://purl.obolibrary.org/obo/PCO_0000001> <http://purl.obolibrary.org/obo/COB_0000022>)
SubClassOf(<http://purl.obolibrary.org/obo/PCO_0000001> <http://purl.obolibrary.org/obo/PCO_0000018>)
SubClassOf(<http://purl.obolibrary.org/obo/PCO_0000001> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002303> <http://purl.obolibrary.org/obo/ENVO_01000739>))

# Class: <http://purl.obolibrary.org/obo/PCO_0000002> (ecological community)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PCO_0000002> "A multi-species collection of organisms of at least two different species, living in a particular area. Must have at least two populations of different species as members."@en)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PCO_0000002> "Ecological community is defined broadly here, but includes both ecological interactions (inherited from parent term community) and spatial co-existence. It may be used to describe every organisms living in an area, but is often used to refer only to organisms of a particular taxon or guild (e.g., the plant community, the insect community, the herbivore community). The word community, as it often used to describe a group of humans living together, is a type of single-species collection of organisms, not an ecological community."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PCO_0000002> "ecological community"@en)
SubClassOf(<http://purl.obolibrary.org/obo/PCO_0000002> <http://purl.obolibrary.org/obo/PCO_0000029>)

# Class: <http://purl.obolibrary.org/obo/PCO_0000018> (single-species collection of organisms)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PCO_0000018> "A material entity that has as parts two or more organisms, viruses, or viroids of the same species and no members of any other species."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PCO_0000018> "single-species collection of organisms"@en)
SubClassOf(<http://purl.obolibrary.org/obo/PCO_0000018> <http://purl.obolibrary.org/obo/PCO_0000000>)

# Class: <http://purl.obolibrary.org/obo/PCO_0000029> (multi-species collection of organisms)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PCO_0000029> "A collection of organisms that consists of two or more organisms from at least two species."@en)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PCO_0000029> ""@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PCO_0000029> "multi-species collection of organisms"@en)
SubClassOf(<http://purl.obolibrary.org/obo/PCO_0000029> <http://purl.obolibrary.org/obo/PCO_0000000>)

# Class: <http://purl.obolibrary.org/obo/PCO_0000031> (organismal entity)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PCO_0000031> "A material entity that is one or more organisms, viruses or viroids.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PCO_0000031> "organismal entity"@en)

