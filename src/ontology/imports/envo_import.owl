SubClassOf(<http://purl.obolibrary.org/obo/FOODON_00001007> <http://purl.obolibrary.org/obo/FOODON_00001010>)

# Class: <http://purl.obolibrary.org/obo/FOODON_00001009> (hot dog)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_00001009> "A hot dog is a moist sausage of soft, even texture and flavor, often made from advanced meat recovery or meat slurry. Most types are fully cooked, cured or smoked. It is often placed hot in a special purpose soft, sliced hot dog bun."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FOODON_00001009> "hotdog"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_00001009> "hot dog"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_00001009> <http://purl.obolibrary.org/obo/FOODON_00001224>)

# Class: <http://purl.obolibrary.org/obo/FOODON_00001010> (processed meat food product)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_00001010> "A processed food product consisting of meat which has been subjected to preservation and/or taste altering processes such as grinding, salting, curing, fermentation, smoking, and addition of chemical preservatives."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_00001010> "processed meat food product"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_00001010> <http://purl.obolibrary.org/obo/FOODON_00001006>)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_00001010> <http://purl.obolibrary.org/obo/FOODON_03311737>)

