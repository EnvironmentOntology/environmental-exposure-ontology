AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PATO_0002268> "centered")
SubClassOf(<http://purl.obolibrary.org/obo/PATO_0002268> <http://purl.obolibrary.org/obo/PATO_0000140>)

