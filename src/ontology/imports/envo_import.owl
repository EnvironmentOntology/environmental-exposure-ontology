AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UBERON_0002075> "viscus")
SubClassOf(<http://purl.obolibrary.org/obo/UBERON_0002075> <http://purl.obolibrary.org/obo/UBERON_0005177>)

