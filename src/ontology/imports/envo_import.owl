# Class: <http://purl.obolibrary.org/obo/ENVO_01000829> (water vapour saturated air)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000829> "Air which has a partial pressure of water vapour equal or near equal to its equilibrium vapor pressure at a given temperature.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_01000829> "water-vapour-saturated air")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01000829> "\"Near equal\" is meant to reflect that there will be fluctuations around the equilibrium point.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000829> "water vapour saturated air"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000829> <http://purl.obolibrary.org/obo/ENVO_01000828>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01000830> (water-based rainfall)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Rain") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000830> "A hydrological precipitation process in which atmospheric water vapour condenses to form droplets of liquid water massive enough to fall to a planetary surface due to the planet's gravity.")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01000830> "This is the process which typically happens on Earth. Other planets may have different liquids involved in the process.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000830> "water-based rainfall"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000830> <http://purl.obolibrary.org/obo/ENVO_01000703>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000830> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000057> <http://purl.obolibrary.org/obo/ENVO_01000829>))
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000830> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000057> <http://purl.obolibrary.org/obo/ENVO_01000832>))

# Class: <http://purl.obolibrary.org/obo/ENVO_01000831> (droplet)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://en.wikipedia.org/wiki/Drop_%28liquid%29>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000831> "A droplet is a small column of liquid, bounded completely or almost completely by free surfaces which maintains its shape due to the surface tension of the liquid.")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01000831> "No attempt is made to differentiate between drops and droplets. This may be added, if requested.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000831> "droplet"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000831> <http://purl.obolibrary.org/obo/ENVO_01001690>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01000832> (raindrop)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000832> "A droplet formed by condensation of vapour in an atmosphere and which is sufficiently massive to overcome atmospheric resistance and fall to a planetary surface due to gravity.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000832> "raindrop"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000832> <http://purl.obolibrary.org/obo/ENVO_01000831>)
