SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000355> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002473> <http://purl.obolibrary.org/obo/NCBITaxon_33090>))

