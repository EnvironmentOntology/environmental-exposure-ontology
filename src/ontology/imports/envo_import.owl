AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000897> "electrostatic discharge process"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000897> <http://purl.obolibrary.org/obo/ENVO_02500000>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01000898> (atmospheric lightning)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Lightning") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000898> "A sudden electrostatic discharge which occurs during an electrical storm as differentially charged atmospheric entities equalise their charge.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_01000898> "lightning")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000898> "atmospheric lightning"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000898> <http://purl.obolibrary.org/obo/ENVO_01000897>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000898> <http://purl.obolibrary.org/obo/ENVO_02500003>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000898> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000057> <http://purl.obolibrary.org/obo/ENVO_01000760>))
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000898> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002234> <http://purl.obolibrary.org/obo/ENVO_01000798>))

