EquivalentClasses(<http://purl.obolibrary.org/obo/ENVO_01000283> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/ENVO_01000325> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/ENVO_00000020>)))
