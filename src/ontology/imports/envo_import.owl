AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01000355> "Usually found in woodlands and forests.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000355> "vegetation layer")
EquivalentClasses(<http://purl.obolibrary.org/obo/ENVO_01000355> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/ENVO_01000281> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002473> <http://purl.obolibrary.org/obo/NCBITaxon_33090>)))
