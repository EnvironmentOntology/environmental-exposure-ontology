AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01000742> "Requested for SDGIO. Likely to be revised.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000742> "carbon-bearing gas emission process"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000742> <http://purl.obolibrary.org/obo/ENVO_03000093>)
