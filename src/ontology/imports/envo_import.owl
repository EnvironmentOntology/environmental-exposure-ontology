# Class: <http://purl.obolibrary.org/obo/ENVO_01001861> (shortwave radiation)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://en.wikipedia.org/wiki/Shortwave_radiation>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01001861> "An electromagnetic radiation process during which radiant energy with wavelengths in the visible, near-ultraviolet, or near-infrared spectra is realised.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_01001861> "short-wave radiation")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://en.wikipedia.org/wiki/Shortwave_radiation>) rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01001861> "There is no standard cut-off for the near-infrared range; therefore, the shortwave radiation range is also variously defined. It may be broadly defined to include all radiation with a wavelength of 0.1 micrometers and 5.0 micrometers or narrowly defined so as to include only radiation between 0.2 micrometers and 3.0 micrometers.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01001861> "shortwave radiation"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01001861> <http://purl.obolibrary.org/obo/ENVO_01001026>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01001864> (photosynthetically active radiation)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://en.wikipedia.org/wiki/Photosynthetically_active_radiation>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01001864> "Electromagnetic radidation which involves radiant energy in a spectral range (wave band) between 400 to 700 nanometers, that photosynthetic organisms are able to use in the process of photosynthesis.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_01001864> "PAR")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01001864> "Many definitions specify that this is Solar radiation, but consistency is lacking.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01001864> "photosynthetically active radiation"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01001864> <http://purl.obolibrary.org/obo/ENVO_01001026>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01001865> (concentration of carbon dioxide in an atmosphere)

