AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/UBERON_0000483> "epithelial tissue")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/UBERON_0000483> "portion of epithelium")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UBERON_0000483> "epithelium")
EquivalentClasses(<http://purl.obolibrary.org/obo/UBERON_0000483> ObjectUnionOf(<http://purl.obolibrary.org/obo/UBERON_0000486> <http://purl.obolibrary.org/obo/UBERON_0000490>))
