# Class: <http://purl.obolibrary.org/obo/ENVO_01000838> (smoke)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Smoke") rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01000838> "Smoke is a collection of airborne solid and liquid particulates and gases emitted when a material undergoes combustion or pyrolysis, together with the quantity of gas that is entrained or otherwise mixed into the mass")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000838> "smoke"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000838> <http://purl.obolibrary.org/obo/ENVO_00010505>)
