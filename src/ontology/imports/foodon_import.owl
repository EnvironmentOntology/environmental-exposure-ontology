AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0025395> "&#243rgano floral (Spanish, exact)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0025395> "flower organ (exact)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0025395> "花器官 (Japanese, exact)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/PO_0025395> "PO:0025395")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PO_0025395> "Includes phyllomes such as anthers and petals, as well as shoot axes such as androphores and gynophores.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PO_0025395> "floral organ")
EquivalentClasses(<http://purl.obolibrary.org/obo/PO_0025395> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PO_0009008> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/PO_0009046>)))
SubClassOf(<http://purl.obolibrary.org/obo/PO_0025395> <http://purl.obolibrary.org/obo/PO_0009008>)
SubClassOf(<http://purl.obolibrary.org/obo/PO_0025395> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/PO_0009046>))

# Class: <http://purl.obolibrary.org/obo/PO_0025430> (phyllome anlagen)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PO_0025430> "A portion of meristem tissue (PO:0009013) that is part of a peripheral zone (PO:0000225) of a shoot apical meristem (PO:0020148) and will give rise to a phyllome primordium (PO:0025128).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/PO_0025430> "PO_GIT:427")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0025430> "フィロム原基 (Japanese, exact)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/PO_0025430> "PO:0025430")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PO_0025430> "The phyllome anlagen is only detectable by gene expression, not morphology.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PO_0025430> "phyllome anlagen")
SubClassOf(<http://purl.obolibrary.org/obo/PO_0025430> <http://purl.obolibrary.org/obo/PO_0009013>)
SubClassOf(<http://purl.obolibrary.org/obo/PO_0025430> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/PO_0000225>))

# Class: <http://purl.obolibrary.org/obo/PO_0025431> (vascular leaf anlagen)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PO_0025431> "A phyllome anlagen (PO:0025430) that will give rise to a vascular leaf primordium (PO:0000017) and is part of a peripheral zone (PO:0000225) of a shoot apical meristem (PO:0020148).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/PO_0025431> "PO_GIT:407")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0025431> "維管束系葉原基 (Japanese, exact)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/PO_0025431> "PO:0025431")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PO_0025431> "This is the region where you have the maximum concentration of auxin in the SAM (at least in a few species that have been studied).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PO_0025431> "vascular leaf anlagen")
SubClassOf(<http://purl.obolibrary.org/obo/PO_0025431> <http://purl.obolibrary.org/obo/PO_0025430>)
SubClassOf(<http://purl.obolibrary.org/obo/PO_0025431> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/PO_0008016>))

# Class: <http://purl.obolibrary.org/obo/PO_0025433> (root anlagen)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PO_0025433> "A portion of meristem tissue (PO:0009013) that is committed to the development of a root primordium (PO:0005029).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/PO_0025433> "PO_GIT:427")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0025433> "precursor de ra&#237 (Spanish, exact)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0025433> "根原基 (Japanese, exact)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/PO_0025433> "PO:0025433")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PO_0025433> "Only detectable by gene expression, not morphology. May arise in a pericycle (PO:0006203), as for lateral roots in most seed plants, an endodermis (PO:0000252), as for lateral roots in ferns, or from parenchyma cells (PO:0000074) that are part a shoot axis (PO:0025029), in the case of a basal root (PO:0025002) or shoot-borne root (PO:0000042).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PO_0025433> "root anlagen")
SubClassOf(<http://purl.obolibrary.org/obo/PO_0025433> <http://purl.obolibrary.org/obo/PO_0009013>)

# Class: <http://purl.obolibrary.org/obo/PO_0025476> (tuberous root tuber)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PO_0025476> "A root (PO:0009005) that develops from a tuberous root (PO:0025523) and is further radially enlarged for storage.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/PO_0025476> "PO_GIT:47")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0025476> "ra&#237z tubercular (Spanish, exact)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0025476> "root tuber (exact)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0025476> "storage root (exact)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0025476> "塊茎根の塊茎(Japanese, exact)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/PO_0025476> "PO:0025476")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PO_0025476> "Functions in storage. This term should be used for tubers derived from roots (PO:0009005), as found in Cassava or sweet potato (Ipomoea batatas), not for tubers derived from branches (PO:0025073), as found in potatoes and yams. Use the term shoot axis tuber (PO:0004543), aerial tuber (PO:0004548), or subterranean tuber (PO:0004547) for tubers derived from branches. A tuberous root tuber may be distinguished from a tuber that is derived from a branch by the presence of a root cap (PO:0020123) early in development, or the presence of lateral roots (PO:0020121) or their remnants. Sometimes tuber roots bear vegetative buds (PO:0000058) like a tuber derived from a branch. A tuberous root tuber usually develops from a shoot-borne root (PO:0000042) or a lateral root (PO:0020121).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PO_0025476> "tuberous root tuber")
SubClassOf(<http://purl.obolibrary.org/obo/PO_0025476> <http://purl.obolibrary.org/obo/PO_0009005>)
SubClassOf(<http://purl.obolibrary.org/obo/PO_0025476> <http://purl.obolibrary.org/obo/PO_0025522>)
SubClassOf(<http://purl.obolibrary.org/obo/PO_0025476> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002202> <http://purl.obolibrary.org/obo/PO_0025523>))

# Class: <http://purl.obolibrary.org/obo/PO_0025477> (floral organ primordium)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PO_0025477> "A primordium (PO:0025127) that is committed to the development of a floral organ (PO:0025395) and is part of a reproductive shoot apex (PO:0025222).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/PO_0025477> "PO_GIT:465")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0025477> "floral structure primordia (exact, plural)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0025477> "portion of floral structure primordium tissue (exact)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0025477> "primordio de organo floral (Spanish, exact)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0025477> "花器官原基 (Japanese, exact)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/PO_0025477> "PO:0025477")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PO_0025477> "If annotating to a primordium of a floral structure, it is better to use the more specific term, such as petal primordium (PO:0000021) or anther primordium (PO:0006089).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PO_0025477> "floral organ primordium")
SubClassOf(<http://purl.obolibrary.org/obo/PO_0025477> <http://purl.obolibrary.org/obo/PO_0025127>)
SubClassOf(<http://purl.obolibrary.org/obo/PO_0025477> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/PO_0025222>))

# Class: <http://purl.obolibrary.org/obo/PO_0025496> (multi-tissue plant structure)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PO_0025496> "A plant structure (PO:0009011) that has as parts two or more portions of plant tissue (PO:0009007) of at least two different types and which through specific morphogenetic processes forms a single structural unit demarcated by primarily bona-fide boundaries from other structural units of different types.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/PO_0025496> "PO_GIT:480")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0025496> "estructura vegetal con m&#250ltiples tejidos (Spanish, exact)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0025496> "複数の組織からなる植物構造 (Japanese, exact)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/PO_0025496> "PO:0025496")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PO_0025496> "Most multi-tissue plant structures have at least a small connection to other plant structures via a fiat boundary, such as where a leaf (PO:0025034) connects to a shoot axis (PO:0025029), a petal (PO:0009032) connects to a receptacle (PO:0009064), or a branch (PO:0025073) connects to a stem (PO:0009047).  Refers to CARO:0000055 multi-tissue structure, def'n: Anatomical structure that has as parts two or more portions of tissue of at least two different types, and which through specific morphogenetic processes, form a single distinct structural unit demarcated by bona-fide boundries from other structural units of differnt types.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PO_0025496> "multi-tissue plant structure")
SubClassOf(<http://purl.obolibrary.org/obo/PO_0025496> <http://purl.obolibrary.org/obo/PO_0009011>)

# Class: <http://purl.obolibrary.org/obo/PO_0025497> (collective plant structure)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PO_0025497> "A plant structure (PO:0009011) that is a proper part of a whole plant (PO:0000003) and includes two or more adjacent plant organs (PO:0009008) or adjacent cardinal organ parts (PO:0025001), along with any associated portions of plant tissue (PO:0009007).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/PO_0025497> "PO_GIT:479")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0025497> "estructura vegetal colectiva (Spanish, exact)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0025497> "集合的植物構造 (Japanese, exact)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/PO_0025497> "PO:0025497")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PO_0025497> "This is a parent term to describe both collective organ part structure (PO:0025269)  (e.g. septum), as well as collective plant organ structure (PO:0025007) (which was formerly named collective plant structure), for example shoot system (PO:0009006).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PO_0025497> "collective plant structure")
SubClassOf(<http://purl.obolibrary.org/obo/PO_0025497> <http://purl.obolibrary.org/obo/PO_0009011>)

# Class: <http://purl.obolibrary.org/obo/PO_0025522> (tuber)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PO_0025522> "A plant axis (PO:0025004) that is radially enlarged.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/PO_0025522> "PO_GIT:127")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0025522> "塊茎 (Japanese, exact)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/PO_0025522> "PO:0025522")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PO_0025522> "Functions in storage of photosynthate metabolites. May develop from a branch (PO:0025073) or a root (PO:0009005).  If you are annotating to tuber, you should pick the more specific child term: shoot axis tuber (PO:0004543) or tuberous root tuber (PO:0025476).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PO_0025522> "tuber")
SubClassOf(<http://purl.obolibrary.org/obo/PO_0025522> <http://purl.obolibrary.org/obo/PO_0025004>)

# Class: <http://purl.obolibrary.org/obo/PO_0025523> (tuberous root)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PO_0025523> "A root (PO:0009005) that is radially enlarged relative to other lateral roots (PO:0020121) or shoot-borne roots (PO:0000042) on the same plant, but not as enlarged as a tuberous root tuber (PO:0025476).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/PO_0025523> "PO_GIT:47")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0025523> "raiz tuberosa (Spanish, exact)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0025523> "塊茎根 (Japanese, exact)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/PO_0025523> "PO:0025523")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PO_0025523> "tuberous root")
SubClassOf(<http://purl.obolibrary.org/obo/PO_0025523> <http://purl.obolibrary.org/obo/PO_0009005>)

# Class: <http://purl.obolibrary.org/obo/PO_0025527> (shoot system development stage)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PO_0025527> "A collective plant organ structure development stage (PO:0025338) that begins with the onset of the plant organ development stage (PO:0025339) and ends with either gametophyte senescent stage (PO:0025343) or sporophyte senescent stage (PO:0007017) or death.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/PO_0025527> "PO_GIT:517")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/PO_0025527> "PO:0025527")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PO_0025527> "The shoot system (PO:0009006) develops fron the shoot apical meristem (PO:0020148) in the plant embryo (PO:0009009) in vascular plants.  In lower plants the gametophore (PO:0030018) arises from a gametophore meristematic apical cell (PO:0030019) in the protonema (PO:0030003).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PO_0025527> "shoot system development stage")
SubClassOf(<http://purl.obolibrary.org/obo/PO_0025527> <http://purl.obolibrary.org/obo/PO_0025338>)
SubClassOf(<http://purl.obolibrary.org/obo/PO_0025527> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000057> <http://purl.obolibrary.org/obo/PO_0009006>))

# Class: <http://purl.obolibrary.org/obo/PO_0025528> (bud development stage)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PO_0025528> "A shoot system development stage (PO:0025527) that has as primary participant a bud (PO:0009006).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/PO_0025528> "PO_GIT:517")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/PO_0025528> "PO:0025528")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PO_0025528> "bud development stage")
SubClassOf(<http://purl.obolibrary.org/obo/PO_0025528> <http://purl.obolibrary.org/obo/PO_0025527>)

# Class: <http://purl.obolibrary.org/obo/PO_0025530> (reproductive shoot system development stage)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PO_0025530> "A shoot system development stage (PO:0025527) that has as primary participant a reproductive shoot system (PO:0025082).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/PO_0025530> "PO_GIT:517")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/PO_0025530> "PO:0025530")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PO_0025530> "reproductive shoot system development stage")
SubClassOf(<http://purl.obolibrary.org/obo/PO_0025530> <http://purl.obolibrary.org/obo/PO_0025527>)

# Class: <http://purl.obolibrary.org/obo/PO_0025606> (native plant cell)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PO_0025606> "A plant cell (PO:0009002) that is either part of a multicellular whole plant (PO:0000003) 'in vivo' or a unicellular organism 'in natura' (i.e. part of a natural environment).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/PO_0025606> "PO_GIT:586")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/PO_0025606> "PO:0025606")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PO_0025606> "A native plant cell is one that is not grown or maintained in vitro, nor part of an in vitro plant structure (PO:0000004).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PO_0025606> "native plant cell")
SubClassOf(<http://purl.obolibrary.org/obo/PO_0025606> <http://purl.obolibrary.org/obo/PO_0009002>)

# Class: <http://purl.obolibrary.org/obo/PO_0025615> (rosette)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PO_0025615> "A collective leaf structure (PO:0025022) consisting of a group of rosette leaves (PO:0000014), generally borne at the base of the plant, that are separated by very short stem internodes (PO:0020142).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/PO_0025615> "PO_GIT:302")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/PO_0025615> "PO_GIT:603")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/PO_0025615> "PO:0025615")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PO_0025615> "rosette")
SubClassOf(<http://purl.obolibrary.org/obo/PO_0025615> <http://purl.obolibrary.org/obo/PO_0025022>)

# Class: <http://purl.obolibrary.org/obo/PO_0028002> (sporophyte development stage)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PO_0028002> "A whole plant development stage (PO:0007033) that has as primary participant a whole plant (PO:0000003) during the interval between fertilization (or apogamy) and death.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/PO_0028002> "PO_GIT:139")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/PO_0028002> "PO_GIT:68")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0028002> "fase esporof&#237tica (Spanish, exact)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0028002> "sporophytic development stage (exact)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0028002> "sporophytic phase (exact)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0028002> "sporphyte phase (exact)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0028002> "胞子体発生過程 (Japanese, exact)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/PO_0028002> "PO:0028002")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PO_0028002> "A whole plant (PO:0000003) in the sporophyte development stage usually has twice the chromosome complement of a plant in the gametophytic phase, but may not in the case of apogamy. Examples of apogamy include both naturally occurring instances (such as sporophytes arising form haploid cells as in bryophytes or ferns) as well as in vitro instances (such as haploid embryo culture or in vitro fusion of non-gamete cells or protoplasts). During the sporophyte development stage, a plant may produce meiospores by meiosis.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PO_0028002> "sporophyte development stage")
SubClassOf(<http://purl.obolibrary.org/obo/PO_0028002> <http://purl.obolibrary.org/obo/PO_0007033>)
SubClassOf(<http://purl.obolibrary.org/obo/PO_0028002> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/PO_0025337>))

# Class: <http://purl.obolibrary.org/obo/PO_0030100> (legume fruit)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PO_0030100> "A fruit (PO:0009001) which develops from a carpel (PO:0009030) and at maturity comprises a dry exocarp (PO:0009085), dry mesocarp (PO:0009087), and dry endocarp (PO:0009086) that dehisce along two fruit valves (PO:0000033).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/PO_0030100> "PO_GIT:645")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0030100> "hülse (exact, German)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0030100> "legumbre (exact, Spanish)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0030100> "legume (exact)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/PO_0030100> "PO:0030100")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PO_0030100> "Legume fruit (PO:0030100) is characteristic of the plant family Fabaceae. Examples: pigeon pea (Cajanus cajan), chickpea (Cicer arietinum), peanut (Arachis hypogaea), soybean (Glycine max), and lentil (Lens culinaris subsp. culinaris).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PO_0030100> "legume fruit")
SubClassOf(<http://purl.obolibrary.org/obo/PO_0030100> <http://purl.obolibrary.org/obo/PO_0009001>)

# Class: <http://purl.obolibrary.org/obo/PO_0030102> (nut fruit)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PO_0030102> "A fruit (PO:0009001) which develops from a gynoecium (PO:0009062) and at maturity comprises a dry exocarp (PO:0009085), dry mesocarp (PO:0009087), and dry endocarp (PO:0009086) that are not fused to a seed coat (PO:0009088).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/PO_0030102> "PO_GIT:646")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0030102> "glandes (exact)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0030102> "glans (exact)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0030102> "nuez (exact, Spanish)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0030102> "nut (exact)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0030102> "nutlet (exact)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0030102> "nuß (exact, German)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/PO_0030102> "PO:0030102")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PO_0030102> "The common names of some species do not accurately reflect their fruit type. For example, the fruit (PO:0009001) of the peanut plant is a legume fruit (PO:0030100) rather than a nut fruit (PO:0030102). Example: pecan (Carya illinoinensis), walnut (Juglans regia), pistachio (Pistacia vera), lotus (Nelumbo nucifera), and acorn (Quercus spp.).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PO_0030102> "nut fruit")
SubClassOf(<http://purl.obolibrary.org/obo/PO_0030102> <http://purl.obolibrary.org/obo/PO_0009001>)

# Class: <http://purl.obolibrary.org/obo/PO_0030103> (drupe fruit)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PO_0030103> "A fruit (PO:0009001) which develops from a carpel (PO:0009030) and at maturity comprises a fleshy exocarp (PO:0009085), fleshy mesocarp (PO:0009087), and a stony endocarp (PO:0009086).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/PO_0030103> "PO_GIT:647")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0030103> "drupa (exact, Spanish)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0030103> "drupe (exact)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0030103> "steinfrucht (exact, German)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0030103> "stone fruit (exact)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0030103> "whole pit fruit"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/PO_0030103> "PO:0030103")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PO_0030103> "May develop from an inferior or superior carpel (PO:0009030) and may contain one or more seeds (PO:0009010). Examples: Amborella trichopoda (basal angiosperm), coffee (Coffea canephora), Cornaceae (Davidia spp.), cashew (Anacardium occidentale), coconut (Cocos nucifera), and almond, peach and plum (Prunus spp.).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PO_0030103> "drupe fruit")
SubClassOf(<http://purl.obolibrary.org/obo/PO_0030103> <http://purl.obolibrary.org/obo/PO_0009001>)

# Class: <http://purl.obolibrary.org/obo/PO_0030104> (caryopsis fruit)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PO_0030104> "A fruit (PO:0009001) which develops from a gynoecium (PO:0009062) and at maturity comprises a dry exocarp (PO:0009085), dry mesocarp (PO:0009087), and dry endocarp (PO:0009086) that are fused to a seed coat (PO:0009088).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/PO_0030104> "PO_GIT:648")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0030104> "brown rice (exact)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0030104> "cariopse (exact, Spanish)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0030104> "cariópside (exact, Spanish)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0030104> "caryopse (exact, German)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0030104> "caryopsides (exact)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0030104> "caryopsis (exact)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0030104> "cereal (exact)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0030104> "dehulled grain (exact)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0030104> "dehulled kernel (exact)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0030104> "grain (exact)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0030104> "kernel (exact)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0030104> "polished rice (exact)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/PO_0030104> "PO:0030104")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PO_0030104> "Caryopsis fruit (PO:0030104) is characteristic of the Poaceae (the grass family). Caryopsis fruits develop from a pseudomonomerous gyneocium (PO:0009062), and contain only a single seed due to the abortion of two of the three carpels (PO:0009030). The pericarp of caryopsis fruits of some bamboo species is somewhat fleshy at maturity and is fused to the seed coat; these fruits are referred to in the literature as bacoid caryopses. Examples: barley (Hordeum vulgare), rice (Oryza spp.), wheat (Triticum spp.), corn (Zea mays), sorghum (Sorghum bicolor), oat (Avena spp.), zebra grass (Miscanthus spp.), Tausch’s goatgrass (Aegilops tauschii), stiff brome (Brachypodium distachyon), cutgrass (Leersia perrieri), and foxtail millet (Setaria italica).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PO_0030104> "caryopsis fruit")
SubClassOf(<http://purl.obolibrary.org/obo/PO_0030104> <http://purl.obolibrary.org/obo/PO_0009001>)

# Class: <http://purl.obolibrary.org/obo/PO_0030108> (berry fruit)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PO_0030108> "A fruit (PO:0009001) which at maturity comprises a fleshy endocarp (PO:0009086), fleshy mesocarp (PO:0009087), and fleshy exocarp (PO:0009085).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/PO_0030108> "PO_GIT:652")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0030108> "bacca (exact)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0030108> "baya (exact, Spanish)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0030108> "beere (exact, German)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0030108> "berry (exact)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/PO_0030108> "PO:0030108")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PO_0030108> "Examples: pepper (Capsicum annuum), papaya (Carica papaya), avocado (Persea americana), may apple (Podophyllum peltatum), date palm (Phoenix dactylifera), tomato (Solanum lycopersicum), potato (Solanum tuberosum), chocolate (Theobroma cacao), blueberry (Vaccinium spp.), and grape (Vitis vinifera).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PO_0030108> "berry fruit")
SubClassOf(<http://purl.obolibrary.org/obo/PO_0030108> <http://purl.obolibrary.org/obo/PO_0009001>)

# Class: <http://purl.obolibrary.org/obo/PO_0030109> (hesperidium fruit)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PO_0030109> "A berry fruit (PO:0030108) which develops from a superior gynoecium (PO:0009062) and at maturity comprises a thickened exocarp (PO:0009085), thickened mesocarp (PO:0009087), and endocarp (PO:0009086), and has as parts juice sacs (PO:0006013) on a carpel adaxial epidermis (PO:0025618).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/PO_0030109> "PO_GIT:652")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0030109> "citrus fruit (exact)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0030109> "hesperide (exact, German)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0030109> "hesperidio (exact, Spanish)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0030109> "hesperidium (exact)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/PO_0030109> "PO:0030109")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PO_0030109> "A hesperidium fruit (PO:0030109) develops from a superior gynoecium (PO:0009062), and therefore is not surrounded by receptacle (PO:0009064) tissue. Examples: orange, grapefruit, lemon, and lime (Citrus spp.).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PO_0030109> "hesperidium fruit")
SubClassOf(<http://purl.obolibrary.org/obo/PO_0030109> <http://purl.obolibrary.org/obo/PO_0030108>)

# Class: <http://purl.obolibrary.org/obo/PO_0030110> (pome fruit)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PO_0030110> "A berry fruit (PO:0030108) which develops from an inferior gynoecium (PO:0009062) and at maturity comprises a fleshy exocarp (PO:0009085), fleshy mesocarp (PO:0009087), and hardened endocarp (PO:0009086) and has as a part a fleshy hypanthium (PO:0009065) which is indistinct from the exocarp (PO:0009085).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/PO_0030110> "PO_GIT:652")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0030110> "apfelfrucht (exact, German)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0030110> "kernfrucht (exact, German)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0030110> "kernobst (exact, German)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0030110> "pome (exact)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0030110> "pomo (exact, Spanish)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/PO_0030110> "PO:0030110")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PO_0030110> "A pome fruit (PO:0030110) is a specialized type of berry fruit (PO:0030108) which is encapsuled in persistent, accrescent receptacle (PO:0009064) and/or hypanthium (PO:0009065) tissue. Examples: Apple, crab apple, and pear (Malus spp. and Pyrus spp.)")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PO_0030110> "pome fruit")
EquivalentClasses(<http://purl.obolibrary.org/obo/PO_0030110> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PO_0030108> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0001000> <http://purl.obolibrary.org/obo/FOODON_03411599>)))
SubClassOf(<http://purl.obolibrary.org/obo/PO_0030110> <http://purl.obolibrary.org/obo/PO_0030108>)
SubClassOf(<http://purl.obolibrary.org/obo/PO_0030110> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0001000> <http://purl.obolibrary.org/obo/FOODON_03411599>))

# Class: <http://purl.obolibrary.org/obo/PO_0030111> (pepo fruit)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PO_0030111> "A berry fruit (PO:0030108) which develops from an inferior carpel (PO:0009030) and at maturity comprises a fleshy exocarp (PO:0009085), fleshy mesocarp (PO:0009087), and fleshy endocarp (PO:0009086), and has as a part a hard receptacle (PO:0009064) which surrounds, and is indistinct from, the exocarp (PO:0009085).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/PO_0030111> "PO_GIT:652")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0030111> "kürbisfrucht (exact, German)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0030111> "pepo (exact)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0030111> "pepónide (exact, Spanish)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/PO_0030111> "PO:0030111")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PO_0030111> "A pepo fruit (PO:0030111) is specialized type of berry fruit (PO:0030108) which is encapsuled by persistent, accrescent receptacle (PO:0009064) tissue. The rind, or tough outer covering, of pepo fruits comprises receptical tissue and at least the exocarp (PO:0009085) layer of the pericarp (PO:0009084). Examples: pumpkin (Cucurbita pepo), cucumber (Cucumis sativus), and watermelon (Citrullus lanatus) and  banana (Musa acuminata).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PO_0030111> "pepo fruit")
SubClassOf(<http://purl.obolibrary.org/obo/PO_0030111> <http://purl.obolibrary.org/obo/PO_0030108>)

# Class: <http://purl.obolibrary.org/obo/PO_0030115> (raceme inflorescence)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PO_0030115> "An inflorescence (PO:0009049) with a monopodial growth habit, which at flowering stage (PO:0007616), is composed of pedicellate flowers (PO:0009046) on an indeterminate, first order inflorescence axis (PO:0025104).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0030115> "raceme (exact)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/PO_0030115> "PO:0030115")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PO_0030115> "Examples include mouse-ear cress (Arabidopsis thaliana, Brassicaceae), wild black cherry (Prunus serotina, Rosaceae), and pokeweeds (Phytolacca spp., Phytolaccaceae).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PO_0030115> "raceme inflorescence")
SubClassOf(<http://purl.obolibrary.org/obo/PO_0030115> <http://purl.obolibrary.org/obo/PO_0009049>)

