AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ONS_1000001> "diet"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ONS_1000001> <http://purl.obolibrary.org/obo/BFO_0000027>)

