AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03411329> "grape cultivar"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03411329> <http://purl.obolibrary.org/obo/FOODON_03411017>)
