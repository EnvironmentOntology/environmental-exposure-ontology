AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CHEBI_39437> "tocol")
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_39437> <http://purl.obolibrary.org/obo/CHEBI_23229>)

