AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CDNO_0000006> "soluble dietary fibre")
SubClassOf(<http://purl.obolibrary.org/obo/CDNO_0000006> <http://purl.obolibrary.org/obo/CDNO_0000005>)
