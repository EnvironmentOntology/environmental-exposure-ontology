# Class: <http://purl.obolibrary.org/obo/MAXO_0000652> (ACE inhibitor therapy)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MAXO_0000652> "Use of a drug that inhibits angiotensin-converting enzyme (ACE), an enzyme that catalyzes the conversion of angiotensin I to angiotensin II. Inhibition of ACE results in a reduction in angiotensin II and angiotensin II-induced aldosterone secretion, causing vasodilation and natriuresis.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/MAXO_0000652> "CHEBI:147289")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/MAXO_0000652> "NCIT:C247")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MAXO_0000652> "Treatment with ACE inhibitor")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MAXO_0000652> "Treatment with angiotensin-converting enzyme inhibitor")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MAXO_0000652> "angiotensin-converting enzyme inhibitor therapy")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MAXO_0000652> "ACE inhibitor therapy"@en)
SubClassOf(<http://purl.obolibrary.org/obo/MAXO_0000652> <http://purl.obolibrary.org/obo/MAXO_0000190>)
SubClassOf(<http://purl.obolibrary.org/obo/MAXO_0000652> <http://purl.obolibrary.org/obo/MAXO_0000191>)

# Class: <http://purl.obolibrary.org/obo/MAXO_0000742> (thiazide diuretic agent therapy)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MAXO_0000742> "Treatment with a benzothiadiazide derivative or other thiazide-like agent with diuretic and anti-hypertensive activity.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/MAXO_0000742> "NCIT:C49185")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MAXO_0000742> "treatment with thiazide diuretic agent")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "NCIT:C49185") rdfs:comment <http://purl.obolibrary.org/obo/MAXO_0000742> "Thiazide diuretics inhibit the sodium-chloride transporter in the distal tubule in the kidneys, thereby suppressing sodium and chloride reabsorption from the distal convoluted tubules (DCT) and increasing the excretion of sodium, chloride, potassium and water. In addition, thiazide diuretics decrease excretion of calcium and uric acid. These agents cause vasodilation possibly by activating calcium-activated potassium channels in vascular smooth muscle and inhibiting various carbonic anhydrases in vascular tissue.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MAXO_0000742> "thiazide diuretic agent therapy"@en)
SubClassOf(<http://purl.obolibrary.org/obo/MAXO_0000742> <http://purl.obolibrary.org/obo/MAXO_0000165>)

# Class: <http://purl.obolibrary.org/obo/MAXO_0000743> (sulfonylurea agent therapy)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MAXO_0000743> "Treatment with sulfonamide urea derivatives with antihyperglycemic activity.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/MAXO_0000743> "NCIT:C97936")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MAXO_0000743> "sulfonylurea antidiabetic agent therapy")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MAXO_0000743> "treatment with sulfonylurea")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MAXO_0000743> "treatment with sulfonylurea agent")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "NCIT:C97936") rdfs:comment <http://purl.obolibrary.org/obo/MAXO_0000743> "Sulphonylurea antidiabetic agents bind to sulfonylurea receptor type 1 (SUR1), the subunit of ATP-sensitive inwardly-rectifier potassium (IKATP) channels on the membranes of pancreatic beta cells, thereby blocking the inward current flow (influx) of positively charged K+ ions into the cell. This results in tonic membrane depolarization, and induces a calcium ion influx through voltage-sensitive calcium channels; increased intracellular calcium ion levels trigger exocytosis of insulin-containing granules. This eventually induces secretion of insulin. The IKATP channels found in pancreatic islets are complexes of four IKATP 6.2 and four SUR1 subunits. In addition, some sulfonylureas of larger molecular size may increase the sensitivity of peripheral tissues to insulin mediated through peroxisome proliferator-activated receptor gamma (PPARgamma).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MAXO_0000743> "sulfonylurea agent therapy"@en)
SubClassOf(<http://purl.obolibrary.org/obo/MAXO_0000743> <http://purl.obolibrary.org/obo/MAXO_0000058>)
SubClassOf(<http://purl.obolibrary.org/obo/MAXO_0000743> <http://purl.obolibrary.org/obo/MAXO_0000258>)

# Class: <http://purl.obolibrary.org/obo/MAXO_0000744> (menopausal hormone therapy)

