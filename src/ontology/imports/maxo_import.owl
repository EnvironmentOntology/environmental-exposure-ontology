AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MAXO_0000250> "non-nucleoside reverse transcriptase inhibitor therapy"@en)
SubClassOf(<http://purl.obolibrary.org/obo/MAXO_0000250> <http://purl.obolibrary.org/obo/MAXO_0000058>)

