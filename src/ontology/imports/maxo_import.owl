AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MAXO_0000259> "insulin treatment")
SubClassOf(<http://purl.obolibrary.org/obo/MAXO_0000259> <http://purl.obolibrary.org/obo/MAXO_0000058>)
