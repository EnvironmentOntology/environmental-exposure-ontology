# Class: <http://purl.obolibrary.org/obo/XCO_0000000> (experimental condition)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22654893") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.thefreedictionary.com/") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/XCO_0000000> "A state of being, an external or environmental factor or a treatment observed or administered prior to or concurrent with an investigative procedure such as an assessment of a morphological or physiological state or property in a single individual or sample or in a group of individuals or samples, especially a state, factor or treatment which has the potential to influence the outcome of such an assessment.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/XCO_0000000> "XCO:0000000")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/XCO_0000000> "experimental condition")

# Class: <http://purl.obolibrary.org/obo/XCO_0000001> (activity)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Dorland:Dorlands_Illustrated_Medical_Dictionary--31st_Ed") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:978-1416049982") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/XCO_0000001> "The state of being involved in some action, either physical or mental.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/XCO_0000001> "XCO:0000001")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/XCO_0000001> "activity")
SubClassOf(<http://purl.obolibrary.org/obo/XCO_0000001> <http://purl.obolibrary.org/obo/XCO_0000000>)

# Class: <http://purl.obolibrary.org/obo/XCO_0000002> (resting)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Dorland:Dorlands_Illustrated_Medical_Dictionary--31st_Ed") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:978-1416049982") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/XCO_0000002> "A state in which the organism is not exhibiting any physical exertion.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/XCO_0000002> "XCO:0000002")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/XCO_0000002> "resting")
SubClassOf(<http://purl.obolibrary.org/obo/XCO_0000002> <http://purl.obolibrary.org/obo/XCO_0000059>)

# Class: <http://purl.obolibrary.org/obo/XCO_0000059> (physical activity)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Dorland:Dorlands_Illustrated_Medical_Dictionary--31st_Ed") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:978-1416049982") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/XCO_0000059> "Action in which a part of the body or whole body is involved in movement.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/XCO_0000059> "XCO:0000059")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/XCO_0000059> "physical activity")
SubClassOf(<http://purl.obolibrary.org/obo/XCO_0000059> <http://purl.obolibrary.org/obo/XCO_0000001>)


