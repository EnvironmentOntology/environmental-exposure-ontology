SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_9516> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000087> <http://purl.obolibrary.org/obo/CHEBI_60186>))

# Class: <http://purl.obolibrary.org/obo/CHEBI_95341> (baricitinib)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CHEBI_95341> "A pyrrolopyrimidine that is 7<em>H</em>-pyrrolo[2,3-<em>d</em>]pyrimidine substituted by a 1-[3-(cyanomethyl)-1-(ethanesulfonyl)azetidin-3-yl]-1<em>H</em>-pyrazol-4-yl group at position 5. It is an FDA approved selective Janus Kinase 1 and 2 (JAK1 and JAK2) inhibitor used for the treatment of rheumatoid arthritis.")
