SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_569624> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000087> <http://purl.obolibrary.org/obo/CHEBI_35718>))
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_569624> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0018038> <http://purl.obolibrary.org/obo/CHEBI_36219>))

