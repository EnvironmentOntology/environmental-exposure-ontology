AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CHEBI_50276> "EC 5.99.1.2 (DNA topoisomerase) inhibitor")
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_50276> <http://purl.obolibrary.org/obo/CHEBI_70727>)

