AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CHEBI_64345> "MALDI matrix material")
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_64345> <http://purl.obolibrary.org/obo/CHEBI_33232>)

