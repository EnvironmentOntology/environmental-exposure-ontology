SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_77734> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0018033> <http://purl.obolibrary.org/obo/CHEBI_77737>))
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_77734> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0018039> <http://purl.obolibrary.org/obo/CHEBI_77736>))

