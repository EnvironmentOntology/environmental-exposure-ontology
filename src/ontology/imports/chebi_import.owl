SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_4877> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000087> <http://purl.obolibrary.org/obo/CHEBI_35703>))
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_4877> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000087> <http://purl.obolibrary.org/obo/CHEBI_78298>))

