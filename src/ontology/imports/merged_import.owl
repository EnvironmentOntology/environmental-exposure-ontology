AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03317669> "SIREN DB annotation:
* solid FOODON:03430151
* starch FOODON:03420203
* food hydrolyzation process FOODON:03460277"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03317669> "starch (hydrolyzed, solid)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03317669> <http://purl.obolibrary.org/obo/FOODON_03301000>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400100> (pie, unsweetened, or pizza (us cfr))

AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400100> <http://www.langual.org/langual_thesaurus.asp?termid=A0100>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03400100> "LanguaL curation note: Used only for unsweetened products; sweetened pies are indexed under *PIE, SWEETENED*."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400100> "pie, unsweetened, or pizza (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400100> <http://purl.obolibrary.org/obo/FOODON_03400102>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400101> (cultured milk product (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400101> "Milk modified by adding acid-producing and/or flavor-producing bacteria under controlled conditions."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400101> <http://www.langual.org/langual_thesaurus.asp?termid=A0101>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400101> "cultured milk product (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400101> <http://purl.obolibrary.org/obo/FOODON_03400148>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400102> (prepared food product with bakery base or enclosure, unsweetened (us cfr))

AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400102> <http://www.langual.org/langual_thesaurus.asp?termid=A0102>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400102> "prepared food product with bakery base or enclosure, unsweetened (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400102> <http://purl.obolibrary.org/obo/FOODON_03400172>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400104> (fruit juice or related product (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400104> "Liquid food prepared from fruit (21 CFR 146). Products prepared from fruit juice by thickening with pectin are indexed under *FRUIT JELLY*; those thickened with gelatin are under *FRUIT BUTTER, JELLY, PRESERVE OR RELATED PRODUCT*."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400104> <http://www.langual.org/langual_thesaurus.asp?termid=A0104>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400104> "fruit juice or related product (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400104> <http://purl.obolibrary.org/obo/FOODON_03400143>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400105> (dressing, condiment, gravy or sauce (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400105> "Seasoned product that contains multiple ingredients and that is used in limited amounts to accompany other foods; excludes flavors, spices and herbs."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400105> <http://www.langual.org/langual_thesaurus.asp?termid=A0105>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400105> "dressing, condiment, gravy or sauce (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400105> <http://purl.obolibrary.org/obo/FOODON_03401270>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400106> (prepared grain or starch product (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400106> "Food product prepared by drying and/or cooking a mixture of milled grain or non-grain starch with a liquid and usually other ingredients such as sweeteners or fats. Includes sweetened and unsweetened bakery products, macaroni or noodle products and breakfast cereals. Excludes *PUDDING, STARCH*, which is under *CUSTARD OR PUDDING*."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400106> <http://www.langual.org/langual_thesaurus.asp?termid=A0106>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400106> "prepared grain or starch product (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400106> <http://purl.obolibrary.org/obo/FOODON_03400125>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400107> (bakery product, unsweetened (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400107> "Includes breads, crackers, pie or pizza crusts and pretzels. Excludes glazed, filled or frosted bakery products, which fall under *BAKERY PRODUCT, SWEETENED* and unsweetened filled products that fall under *PREPARED FOOD PRODUCT WITH BAKERY BASE OR ENCLOSURE, UNSWEETENED* or the appropriate narrower term.  See 21 CFR for description of some subgroups."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400107> <http://www.langual.org/langual_thesaurus.asp?termid=A0107>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400107> "bakery product, unsweetened (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400107> <http://purl.obolibrary.org/obo/FOODON_03400191>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400112> (nonalcoholic beverage (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400112> "Beverage containing no more than 0.5% alcohol; it may be flavored, sweetened or carbonated; includes soft drinks and steeped beverages; excludes milk in all forms, fruit juices, diluted fruit juices and vegetable juices."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400112> <http://www.langual.org/langual_thesaurus.asp?termid=A0112>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400112> "nonalcoholic beverage (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400112> <http://purl.obolibrary.org/obo/FOODON_03400229>)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400112> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/RO_0002351> <http://purl.obolibrary.org/obo/FOODON_00002057>))

# Class: <http://purl.obolibrary.org/obo/FOODON_03400113> (spice or herb (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400113> "Aromatic or pungent plant product used whole or ground as a seasoning in food products."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400113> <http://www.langual.org/langual_thesaurus.asp?termid=A0113>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400113> "spice or herb (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400113> <http://purl.obolibrary.org/obo/FOODON_03400133>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400114> (frozen dairy dessert (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400114> "A frozen dessert prepared from one or more dairy ingredients or their analogs, plus other ingredients. Includes frozen dairy items offered in a cone, a sandwich or as a cake or pie, such as frozen yogurt in a cone or an ice cream sandwich; these are also indexed under *GRAIN ADDED*."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400114> <http://www.langual.org/langual_thesaurus.asp?termid=A0114>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400114> "frozen dairy dessert (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400114> <http://purl.obolibrary.org/obo/FOODON_03400164>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400115> (cheese or cheese product (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400115> "Natural cheese, cured or uncured, cheese product (which is further processed), or cheese product analog."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400115> <http://www.langual.org/langual_thesaurus.asp?termid=A0115>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400115> "cheese or cheese product (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400115> <http://purl.obolibrary.org/obo/FOODON_03400164>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400118> (nutritive sweetener (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400118> "A substance having greater than 2% of the caloric value of sucrose per equivalent unit of sweetening capacity. For example, the amount of such subtance having the sweetening capacity of 1 teaspoon of sucrose would have more than 0.4 calories (21 CFR 170.3(o)(21))."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400118> <http://www.langual.org/langual_thesaurus.asp?termid=A0118>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400118> "nutritive sweetener (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400118> <http://purl.obolibrary.org/obo/FOODON_03400237>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400125> (grain or starch product (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400125> "Any form of whole or milled grain, prepared grain product or starch containing product derived from non-grain sources. [FDA CFSAN 1995]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400125> <http://www.langual.org/langual_thesaurus.asp?termid=A0125>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400125> "grain or starch product (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400125> <http://purl.obolibrary.org/obo/FOODON_03401270>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400127> (fruit juice (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400127> "The liquid extracted or expressed from mature fruit with or without the application of heat. Includes concentrated juice and single-strength juice. If the single-strength juice is prepared from concentrate, then *WATER ADDED* should be used. Carbonated fruit juices are indexed by *FRUIT JUICE* or *FRUIT JUICE, DILUTED* and *CARBONATED* or the appropriate narrower term."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400127> <http://www.langual.org/langual_thesaurus.asp?termid=A0127>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400127> "fruit juice (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400127> <http://purl.obolibrary.org/obo/FOODON_03400104>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400128> (cheese product analog (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400128> "Food product having functional characteristics similar to those of cheese or cheese product; it may be nutritionally equivalent or inferior to the product it purports to resemble. The ingredients may or may not be milk-based. An example is a cheese-like product made from skim milk and vegetable oil."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400128> <http://www.langual.org/langual_thesaurus.asp?termid=A0128>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400128> "cheese product analog (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400128> <http://purl.obolibrary.org/obo/FOODON_03400115>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400129> (refined or partially-refined food product (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400129> "Extract, concentrate or isolate derived from a food source through one or more refining steps (see *EXTRACT, CONCENTRATE OR ISOLATE OF PLANT OR ANIMAL*) and marketed as such. [FDA CFSAN 1995]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400129> <http://www.langual.org/langual_thesaurus.asp?termid=A0129>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400129> "refined or partially-refined food product (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400129> <http://purl.obolibrary.org/obo/FOODON_03401270>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400131> (poultry-based sausage or luncheon meat (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400131> "Food product consisting of comminuted poultry meat, usually seasoned, pressed and/or encased."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400131> <http://www.langual.org/langual_thesaurus.asp?termid=A0131>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400131> "poultry-based sausage or luncheon meat (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400131> <http://purl.obolibrary.org/obo/FOODON_03400273>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400132> (meat product analog (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400132> "Food product having functional characteristics similar to a meat product; it may be nutritionally equivalent or inferior to the product it purports to resemble. Typically these products are soybean-based."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400132> <http://www.langual.org/langual_thesaurus.asp?termid=A0132>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400132> "meat product analog (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400132> <http://purl.obolibrary.org/obo/FOODON_03400150>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400133> (flavoring or seasoning (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400133> "Product that imparts or helps to impart a taste or aroma in food (21 CFR.170.3(n)(26). [FDA CFSAN 1995]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400133> <http://www.langual.org/langual_thesaurus.asp?termid=A0133>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400133> "flavoring or seasoning (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400133> <http://purl.obolibrary.org/obo/FOODON_03401270>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400135> (bakery product, sweetened (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400135> "Includes cakes, cookies, pies, quick breads, doughnuts and related products, also bakery products that are glazed, frosted or have a sweetened filling. If sugar is not the first ingredient, *SUGAR OR SUGAR SYRUP ADDED* as well as *SWEETENER ADDED* (or the appropriate narrower term under each) should be indexed in *H. TREATMENT APPLIED*."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400135> <http://www.langual.org/langual_thesaurus.asp?termid=A0135>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400135> "bakery product, sweetened (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400135> <http://purl.obolibrary.org/obo/FOODON_03400191>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400136> (nonstandardized dressing (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400136> "Dressing for which no standards of identity are specified in the CFR."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400136> <http://www.langual.org/langual_thesaurus.asp?termid=A0136>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400136> "nonstandardized dressing (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400136> <http://purl.obolibrary.org/obo/FOODON_03400276>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400137> (ice cream or frozen custard (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400137> "A frozen dairy dessert prepared by freezing while stirring a mixture of pasteurized dairy ingredients and other optional ingredients specified in 21 CFR 135.110 (a). These exclude fats and nonnutritive sweeteners not derived from milk; the finished product has at least 10% milk fat and 10% nonfat milk solids."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400137> <http://www.langual.org/langual_thesaurus.asp?termid=A0137>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400137> "ice cream or frozen custard (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400137> <http://purl.obolibrary.org/obo/FOODON_03400114>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400139> (multicomponent meal (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400139> "A multiple-component food product typically containing a protein source, a vegetable, and a potato, rice or cereal-based component packaged to be served after heating, either as separate items or courses or mixed as recipe components; see 21 CFR 102.26, 102.28 and 104.47 for nutritional quality guidelines."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400139> <http://www.langual.org/langual_thesaurus.asp?termid=A0139>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400139> "multicomponent meal (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400139> <http://purl.obolibrary.org/obo/FOODON_03400172>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400143> (fruit or fruit product (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400143> "Fruit in all forms; includes fruit juices and fruit juice drinks, fruit butters, jellies, preserves, and related products."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400143> <http://www.langual.org/langual_thesaurus.asp?termid=A0143>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400143> "fruit or fruit product (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400143> <http://purl.obolibrary.org/obo/FOODON_03400257>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400147> (milk or milk product analog (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400147> "Food product having functional characteristics similar to milk or milk products, including cream product analogs, margarine, and milk analogs. Certain alternate ingredients are substituted for those components that are responsible for specific functional properties."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400147> <http://www.langual.org/langual_thesaurus.asp?termid=A0147>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400147> "milk or milk product analog (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400147> <http://purl.obolibrary.org/obo/FOODON_03400148>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400148> (milk or milk product (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400148> "Milk in all forms, milk-based beverage, cultured milk product, or milk or milk product analog. Index infant formula under *MEAL REPLACEMENT*."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400148> <http://www.langual.org/langual_thesaurus.asp?termid=A0148>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400148> "milk or milk product (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400148> <http://purl.obolibrary.org/obo/FOODON_03400164>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400149> (milled grain or starch product (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400149> "Food product prepared by milling a grain or by producing flour, meal or grits from a non-grain source such as beans, starchy roots or tubers. Refined starch is indexed under *REFINED OR PARTIALLY REFINED FOOD PRODUCT*."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400149> <http://www.langual.org/langual_thesaurus.asp?termid=A0149>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400149> "milled grain or starch product (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400149> <http://purl.obolibrary.org/obo/FOODON_03400125>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400150> (meat or meat product (from mammal) (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400150> "Meat (flesh and organs including blood and bone marrow) from mammals. Used for meat in all forms including cured meat, sausage or luncheon meat and meat product analogs."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400150> <http://www.langual.org/langual_thesaurus.asp?termid=A0150>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400150> "meat or meat product (from mammal) (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400150> <http://purl.obolibrary.org/obo/FOODON_03400217>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400152> (vegetable or vegetable product (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400152> "Vegetables in all forms except where a use-related product type descriptior (such as *PREPARED FOOD PRODUCT* or *SNACK FOOD*) takes precedence."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400152> <http://www.langual.org/langual_thesaurus.asp?termid=A0152>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400152> "vegetable or vegetable product (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400152> <http://purl.obolibrary.org/obo/FOODON_03400257>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400155> (fruit butter, jelly, preserve or related product (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400155> "Semisolid or jelled food prepared from fruit or fruit juice and other ingredients prescribed for the individual products (21 CFR 150)."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400155> <http://www.langual.org/langual_thesaurus.asp?termid=A0155>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400155> "fruit butter, jelly, preserve or related product (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400155> <http://purl.obolibrary.org/obo/FOODON_03400143>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400164> (dairy product (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400164> "Milk, a product derived from milk, or a dairy product analog; includes cheese and frozen dairy desserts. [FDA CFSAN 1995]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400164> <http://www.langual.org/langual_thesaurus.asp?termid=A0164>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400164> "dairy product (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400164> <http://purl.obolibrary.org/obo/FOODON_03401270>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400167> (pizza crust (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400167> "Yeast-leavened bread that is used as a base for filling, particularly to make pizza."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400167> <http://www.langual.org/langual_thesaurus.asp?termid=A0167>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400167> "pizza crust (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400167> <http://purl.obolibrary.org/obo/FOODON_03400178>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400172> (prepared food product (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400172> "Food product that is 1) ready or nearly ready for consumption; 2) usually a composite of several foods or ingredients that often belong to distinct product types; 3) usually formulated, mixed and partially or fully cooked. Prepared foods often undergo several of the processes listed in *F. EXTENT OF HEAT TREATMENT* and *H. TREATMENT APPLIED*; these factors should be carefully considered in indexing. The classification of prepared food products emphasizes consumption characteristics. [FDA CFSAN 1995]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400172> <http://www.langual.org/langual_thesaurus.asp?termid=A0172>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400172> "prepared food product (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400172> <http://purl.obolibrary.org/obo/FOODON_03401270>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400178> (bread (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400178> "Unsweetened bakery product that may be unleavened or yeast-leavened and may be baked in various forms. Excludes pie crust."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400178> <http://www.langual.org/langual_thesaurus.asp?termid=A0178>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400178> "bread (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400178> <http://purl.obolibrary.org/obo/FOODON_03400107>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400179> (condiment or relish (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400179> "Food product that is usually pungent, tart, salty, or spicy and is used to enhance the flavors of other foods; includes catsup, relish, prepared mustard, prepared horseradish, and condiment sauces."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400179> <http://www.langual.org/langual_thesaurus.asp?termid=A0179>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400179> "condiment or relish (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400179> <http://purl.obolibrary.org/obo/FOODON_03400105>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400182> (milk analog (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400182> "Food product having functional characteristics similar to milk; it may be nutritionally equivalent or inferior to the product it purports to resemble."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400182> <http://www.langual.org/langual_thesaurus.asp?termid=A0182>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400182> "milk analog (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400182> <http://purl.obolibrary.org/obo/FOODON_03400147>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400183> (quick bread, sweetened (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400183> "Chemically leavened sweetened bakery product that may contain other ingredients such as fruits, nuts or that may be filled."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400183> <http://www.langual.org/langual_thesaurus.asp?termid=A0183>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400183> "quick bread, sweetened (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400183> <http://purl.obolibrary.org/obo/FOODON_03400135>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400185> (uncured cheese (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400185> "Natural cheese that is not cured or is cured for less than 7 days. It may undergo some further processing, such as creaming. It is consumed fresh and has a mild acid flavor. Moisture max. 80%. Includes such products as cottage cheese, cream cheese and mozzarella cheese."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400185> <http://www.langual.org/langual_thesaurus.asp?termid=A0185>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400185> "uncured cheese (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400185> <http://purl.obolibrary.org/obo/FOODON_03400187>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400187> (natural cheese (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400187> "Cheese made from milk or milk components, such as cream, by the following process: (1) produce curd through coagulation of milk by bacterial action and/or enzymes and/or acidification and draining of whey. (2) For cured cheese only: cure the curd. Excludes products made through further processing, such as comminuting (see *CHEESE PRODUCT*)."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400187> <http://www.langual.org/langual_thesaurus.asp?termid=A0187>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400187> "natural cheese (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400187> <http://purl.obolibrary.org/obo/FOODON_03400115>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400188> (confectionery (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400188> "Candy or other food product made with sweeteners and frequently containing nuts, fruits, starches, flavorings and other foods (21 CFR 170.3(n)(9). [FDA CFSAN 1995]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400188> <http://www.langual.org/langual_thesaurus.asp?termid=A0188>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400188> "confectionery (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400188> <http://purl.obolibrary.org/obo/FOODON_03401270>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400191> (bakery product (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400191> "Prepared grain product made by baking or frying. Includes doughs, batters and mixes."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400191> <http://www.langual.org/langual_thesaurus.asp?termid=A0191>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400191> "bakery product (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400191> <http://purl.obolibrary.org/obo/FOODON_03400106>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400194> (pancake or waffle (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400194> "A thin, sweetened bakery product griddled or cooked in a heated mold."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400194> <http://www.langual.org/langual_thesaurus.asp?termid=A0194>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400194> "pancake or waffle (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400194> <http://purl.obolibrary.org/obo/FOODON_03400135>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400202> (pastry, sweetened (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400202> "Sweetened bakery product consisting of a sweetened or unsweetened pastry shell or enclosure containing a sweetened filling, usually fruit, cheese or custard. Examples would be apple strudel, danish pastry or cream puff."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400202> <http://www.langual.org/langual_thesaurus.asp?termid=A0202>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400202> "pastry, sweetened (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400202> <http://purl.obolibrary.org/obo/FOODON_03400135>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400203> (cookie (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400203> "Sweetened bakery product baked in individual portions that are usually small and flat."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400203> <http://www.langual.org/langual_thesaurus.asp?termid=A0203>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400203> "cookie (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400203> <http://purl.obolibrary.org/obo/FOODON_03400135>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400204> (candy (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400204> "Food product prepared by heating a mixture of sweeteners and other optional ingredients according to the specific formula for each subgroup."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400204> <http://www.langual.org/langual_thesaurus.asp?termid=A0204>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400204> "candy (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400204> <http://purl.obolibrary.org/obo/FOODON_03400188>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400205> (wine, 7-24% alcohol (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400205> "Alcoholic beverage produced by the normal fermentation of the juice of grapes or other fruits or of the fermentable parts of plants or plant-related products; may contain certain optional ingredients. Contains between 7-24% alcohol by volume (27 CFR 4.10)."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400205> <http://www.langual.org/langual_thesaurus.asp?termid=A0205>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400205> "wine, 7-24% alcohol (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400205> <http://purl.obolibrary.org/obo/FOODON_03400297>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400211> (frozen yogurt (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400211> "A frozen dessert prepared from yogurt and other ingredients."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400211> <http://www.langual.org/langual_thesaurus.asp?termid=A0211>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400211> "frozen yogurt (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400211> <http://purl.obolibrary.org/obo/FOODON_03400114>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400212> (stew or hash (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400212> "Prepared dish consisting of a mixture of meat, poultry or seafood with one or more vegetables and possibly other ingredients. In contrast to soups, which are liquid or semiliquid, stews are thickened or have a larger proportion of solid ingredients."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400212> <http://www.langual.org/langual_thesaurus.asp?termid=A0212>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400212> "stew or hash (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400212> <http://purl.obolibrary.org/obo/FOODON_03400172>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400215> (flavoring (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400215> "Natural or synthetic product, dissolved in a suitable solvent or carried on an appropriate dry base and added to a food product to enhance or impart taste and aroma."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400215> <http://www.langual.org/langual_thesaurus.asp?termid=A0215>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400215> "flavoring (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400215> <http://purl.obolibrary.org/obo/FOODON_03400300>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400217> (meat, poultry, seafood or related product (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400217> "Products of the flesh of animals. [FDA CFSAN 1995]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400217> <http://www.langual.org/langual_thesaurus.asp?termid=A0217>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400217> "meat, poultry, seafood or related product (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400217> <http://purl.obolibrary.org/obo/FOODON_03401270>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400218> (sandwich (us cfr))

AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400218> <http://www.langual.org/langual_thesaurus.asp?termid=A0218>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03400218> "LanguaL curation note: Sandwich takes precedent over other product types. Examples: peanut butter and jelly sandwich, tuna sandwich, egg salad sandwich or hamburger on roll. The filling of a sandwich is always indexed as the food source, even if the bread is the same weight or outweighs the filling ingredient(s). The bread would be indexed by *GRAIN ADDED* or the appropriate narrower term."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400218> "sandwich (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400218> <http://purl.obolibrary.org/obo/FOODON_03400102>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400221> (sausage or luncheon meat (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400221> "This category includes a wide variety of products made from comminuted or chopped meat (skeletal and/or organ meat) that is usually salted and/or seasoned and often stuffed in an edible or inedible casing. Includes products such as pork sausage, pickle or pimiento loaf, meat spread and pate, and products made by binding meat chunks with gelatin or other binders, such as sectioned and formed ham, beef rolls, and headcheese. Excludes plain ground meat, meat loaf and products made by slicing intact muscle or other tissue, even if packaged and marketed like luncheon meat. Index all processes applied to the product at hand; examples: *FULLY HEAT TREATED*, *CURED FOR 2 MONTHS*, *SMOKED*, *FERMENTED*, *EMULSIFIED OR HOMOGENIZED*. Also consider *PARTICLE SIZE IN SOLID FORMED PRODUCTS* and *TYPEOF SAUSAGE CASING* in *Z. ADJUNCT CHARACTERISTICS OF FOOD*."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400221> <http://www.langual.org/langual_thesaurus.asp?termid=A0221>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400221> "sausage or luncheon meat (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400221> <http://purl.obolibrary.org/obo/FOODON_03400150>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400222> (dessert (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400222> "Sweetened prepared product usually consumed after the main course in a meal. Excludes fruit or fruit products, bakery products and confectionery."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400222> <http://www.langual.org/langual_thesaurus.asp?termid=A0222>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400222> "dessert (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400222> <http://purl.obolibrary.org/obo/FOODON_03400172>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400227> (ice cream (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400227> "Ice cream, in comparison with frozen custard, contains less than 1.4% egg yolk solids by weight of the finished product (21 CFR 135.110(a))."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400227> <http://www.langual.org/langual_thesaurus.asp?termid=A0227>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400227> "ice cream (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400227> <http://purl.obolibrary.org/obo/FOODON_03400137>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400228> (snack food (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400228> "Unsweetened food product marketed for consumption between meals; excludes nuts, edible seeds, and sweetened products such as cakes, puddings and candies. [FDA CFSAN 1995]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400228> <http://www.langual.org/langual_thesaurus.asp?termid=A0228>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400228> "snack food (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400228> <http://purl.obolibrary.org/obo/FOODON_03401270>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400229> (beverage (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400229> "Alcoholic or nonalcoholic beverage; excludes milk and milk-based beverages, fruit juices and fruit juice drinks, and vegetable juices. [FDA CFSAN 1995]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400229> <http://www.langual.org/langual_thesaurus.asp?termid=A0229>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400229> "beverage (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400229> <http://purl.obolibrary.org/obo/FOODON_03401270>)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400229> ObjectIntersectionOf(ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002351> <http://purl.obolibrary.org/obo/FOODON_03301977>) ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/RO_0002351> <http://purl.obolibrary.org/obo/FOODON_03301977>)))

# Class: <http://purl.obolibrary.org/obo/FOODON_03400231> (margarine (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400231> "Food product having functional characteristics similar to those of butter; it is in plastic form or liquid emulsion and contains not less than 80% fat whose origin is vegetable or rendered animal carcass fats or a mixture of these as well as other optional ingredients specified by 21 CFR 166.110."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400231> <http://www.langual.org/langual_thesaurus.asp?termid=A0231>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400231> "margarine (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400231> <http://purl.obolibrary.org/obo/FOODON_03400294>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400237> (sweetener (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400237> "A product added to a food item to achieve some degree of sweet taste; it may be nutritive or nonnutritive."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400237> <http://www.langual.org/langual_thesaurus.asp?termid=A0237>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400237> "sweetener (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400237> <http://purl.obolibrary.org/obo/FOODON_03400133>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400241> (soft drink (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400241> "Nonalcoholic beverage made from potable water by adding one or more of the following: carbon dioxide, flavoring ingredients or sweeteners. Naturally or artificially carbonated mineral waters are also considered soft drinks. Excludes products containing 15% or more fruit juice, which are indexed by the appropriate narrower term under *FRUIT JUICE OR RELATED PRODUCT*. Includes beverage bases to make soft drinks. Carbonated fruit juices are indexed by *FRUIT JUICE* or *FRUIT JUICE, DILUTED* and *CARBONATED* or the appropriate narrower term."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400241> <http://www.langual.org/langual_thesaurus.asp?termid=A0241>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400241> "soft drink (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400241> <http://purl.obolibrary.org/obo/FOODON_03400112>)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400241> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/RO_0002351> <http://purl.obolibrary.org/obo/FOODON_03316090>))

# Class: <http://purl.obolibrary.org/obo/FOODON_03400242> (cracker (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400242> "Unsweetened bakery product baked in individual portions that are usually thin and crisp and may or may not be fat coated."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400242> <http://www.langual.org/langual_thesaurus.asp?termid=A0242>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400242> "cracker (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400242> <http://purl.obolibrary.org/obo/FOODON_03400107>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400248> (doughnut (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400248> "Deep-fat fried sweetened bakery product that may be leavened with yeast or baking powder."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400248> <http://www.langual.org/langual_thesaurus.asp?termid=A0248>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400248> "doughnut (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400248> <http://purl.obolibrary.org/obo/FOODON_03400135>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400251> (fruit preserve or jam (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400251> "Viscous or semisolid fruit product made from whole fruits or pieces of fruit of one or more varieties and optional ingredients.  Includes fruit preserve or jam (21 CFR 150.160) and artificially sweetened fruit preserve or jam (21 CFR 150.161).  The specifications of starting mixture and finished soluble solids are the same as for fruit jelly."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400251> <http://www.langual.org/langual_thesaurus.asp?termid=A0251>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400251> "fruit preserve or jam (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400251> <http://purl.obolibrary.org/obo/FOODON_03400155>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400253> (pie, sweetened (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400253> "Sweetened bakery product consisting of a sweetened or unsweetened pie crust and a sweetened filling. The filling is always indexed as the food source, even if the crust is the same weight or greater weight than the filling ingredient."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400253> <http://www.langual.org/langual_thesaurus.asp?termid=A0253>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400253> "pie, sweetened (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400253> <http://purl.obolibrary.org/obo/FOODON_03400135>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400257> (fruit or vegetable product (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400257> "Fruits and vegetables in all forms. [FDA CFSAN 1995]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400257> <http://www.langual.org/langual_thesaurus.asp?termid=A0257>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400257> "fruit or vegetable product (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400257> <http://purl.obolibrary.org/obo/FOODON_03401270>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400258> (breakfast cereal (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400258> "Prepared grain product ready or nearly ready for consumption and marketed primarily for breakfast use. Includes formulated breakfast cereals such as 'corn flakes' or 'cheerios' and simple breakfast cereals such as instant oatmeal. Excludes rolled oats, corn grits and similar products, which are indexed under *MILLED GRAIN OR STARCH PRODUCT*. See also *MILLED GRAIN OR STARCH PRODUCT*."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400258> <http://www.langual.org/langual_thesaurus.asp?termid=A0258>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400258> "breakfast cereal (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400258> <http://purl.obolibrary.org/obo/FOODON_03400106>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400260> (nut or nut product (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400260> "Nuts in all forms, including nut butters and pastes."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400260> <http://www.langual.org/langual_thesaurus.asp?termid=A0260>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400260> "nut or nut product (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400260> <http://purl.obolibrary.org/obo/FOODON_03400306>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400264> (vegetable juice (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400264> "The liquid extracted or expressed from mature vegetables with or without optional ingredients such as seasoning or salt.  Products prepared from vegetable juice by thickening with gelatin or pectin are indexed under the broader term *VEGETABLE OR VEGETABLE PRODUCT*. For part or portion, index the part or the plant from which the juice was extracted, rather than *PLANT EXTRACT, CONCENTRATE, OR ISOLATE*."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400264> <http://www.langual.org/langual_thesaurus.asp?termid=A0264>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400264> "vegetable juice (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400264> <http://purl.obolibrary.org/obo/FOODON_03400152>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400267> (seafood or seafood product (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400267> "Flesh from fish or shellfish. Includes seafood product analogs and seafood-based sausage or luncheon meat as well as such products as squid ink and clam juice."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400267> <http://www.langual.org/langual_thesaurus.asp?termid=A0267>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400267> "seafood or seafood product (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400267> <http://purl.obolibrary.org/obo/FOODON_03400217>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400268> (steeped beverage (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400268> "Beverage prepared by extracting flavor and other components from food sources by percolation and/or immersion in water, usually at near-boiling temperature."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400268> <http://www.langual.org/langual_thesaurus.asp?termid=A0268>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400268> "steeped beverage (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400268> <http://purl.obolibrary.org/obo/FOODON_03400112>)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400268> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/RO_0002351> <http://purl.obolibrary.org/obo/FOODON_00002275>))

# Class: <http://purl.obolibrary.org/obo/FOODON_03400272> (cacao or chocolate product (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400272> "Any form of cacao, cacao product, chocolate, chocolate product or chocolate product analog except chocolate candy; includes such products as cacao beans, cacao nibs, chocolate liquor, sweet or milk chocolate, and chocolate syrup; excludes flavors and extracts derived from cacao beans and chocolate- or cacao-flavored foods (21 CFR 163). [FDA CFSAN 1995]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400272> <http://www.langual.org/langual_thesaurus.asp?termid=A0272>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400272> "cacao or chocolate product (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400272> <http://purl.obolibrary.org/obo/FOODON_03401270>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400273> (poultry or poultry product (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400273> "Meat (flesh and organs including blood and bone marrow) from poultry. Used for poultry meat in all forms including poultry product analogs and poultry-based sausage or luncheon meat."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400273> <http://www.langual.org/langual_thesaurus.asp?termid=A0273>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400273> "poultry or poultry product (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400273> <http://purl.obolibrary.org/obo/FOODON_03400217>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400274> (meal replacement (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400274> "Formulated and often nutritionally controlled product marketed for consumption in place of a conventional meal. The product may be used as the sole or major source of nourishment. It is frequently offered in a form convenient to use. Includes infant formula, products designed for weight loss, instant breakfast, interal and parenteral complete nutrition solutions, etc."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400274> <http://www.langual.org/langual_thesaurus.asp?termid=A0274>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400274> "meal replacement (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400274> <http://purl.obolibrary.org/obo/FOODON_03400309>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400275> (macaroni or noodle product (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400275> "A prepared grain or starch product made by forming units of dough composed of one or more flours, water and other ingredients. Macaroni, spaghetti and vermicelli may have *EGG WHITE ADDED*, but not egg yolk. Noodles, egg macaroni, egg spaghetti and egg vermicelli have *EGG YOLK ADDED* and should be so indexed. This refers to macaroni or noodles used as ingredients; excludes *PASTA DISH*, which is found under *PREPARED FOOD PRODUCT* (21 CFR 139)."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400275> <http://www.langual.org/langual_thesaurus.asp?termid=A0275>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400275> "macaroni or noodle product (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400275> <http://purl.obolibrary.org/obo/FOODON_03400106>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400276> (dressing for food (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400276> "Standardized or nonstandardized mixture of edible fats or oils, acidifying agents and optional ingredients such as sweeteners (nutritive or nonnutritive), starch, egg and seasonings. Used in limited amounts to accompany salads and other foods."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400276> <http://www.langual.org/langual_thesaurus.asp?termid=A0276>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400276> "dressing for food (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400276> <http://purl.obolibrary.org/obo/FOODON_03400105>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400278> (alcoholic beverage (us cfr))

