ObjectPropertyRange(<http://purl.obolibrary.org/obo/RO_0002295> <http://purl.obolibrary.org/obo/UBERON_0001062>)

# Object Property: <http://purl.obolibrary.org/obo/RO_0002297> (results in formation of anatomical entity)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/RO_0002297> "results in formation of anatomical entity"@en)
SubObjectPropertyOf(<http://purl.obolibrary.org/obo/RO_0002297> <http://purl.obolibrary.org/obo/RO_0002234>)
