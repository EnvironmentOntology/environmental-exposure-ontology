EquivalentClasses(<http://purl.obolibrary.org/obo/ENVO_01001334> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/ENVO_03000010> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000053> <http://purl.obolibrary.org/obo/ENVO_01003012>)))
