AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03420178> "seed part"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03420178> <http://purl.obolibrary.org/obo/BFO_0000040>)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03420178> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002160> <http://purl.obolibrary.org/obo/NCBITaxon_33090>))

# Class: <http://purl.obolibrary.org/obo/FOODON_03420183> (sprout)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03420183> "A young plant growing from a seed; may have small leaves. The endosperm is diminished or removed."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03420183> <http://www.langual.org/langual_thesaurus.asp?termid=C0183>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03420183> "LanguaL curation note: Compare *GERMINATED OR SPROUTED SEED* and *STEM, STALK (WITHOUT LEAVES)*."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03420183> "sprout"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03420183> <http://purl.obolibrary.org/obo/FOODON_03420144>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03420190> (fat or oil)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03420190> "Food substance or component consisting predominantly of mixed glycerol esters of fatty acids and, in far lesser amounts, of fatty acids, sterols and pigments. A fat is a solid at room temperature, an oil is a liquid at room temperature (20 degrees C.). Excludes essential oils."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03420190> <http://www.langual.org/langual_thesaurus.asp?termid=H0221>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03420190> <https://bioregistry.io/reference/siren:F15008>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03420190> "langual:C0190")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03420190> "SIREN DB annotation:
* liquid, high viscosity, with no visible particles FOODON:03430139
* solid FOODON:03430151
* fat or oil FOODON:03420190"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03420190> "fat or oil"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03420190> <http://purl.obolibrary.org/obo/FOODON_00002196>)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03420190> <http://purl.obolibrary.org/obo/FOODON_00002664>)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03420190> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002350> <http://purl.obolibrary.org/obo/FOODON_03400129>))

# Class: <http://purl.obolibrary.org/obo/FOODON_03420208> (seed, skin removed, germ removed (endosperm))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03420208> "The bulk of a seed; germ and bran are removed."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03420208> <http://www.langual.org/langual_thesaurus.asp?termid=C0208>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03420208> "LanguaL curation note: Renamed from *SEED OR KERNEL, SKIN REMOVED, GERM REMOVED (ENDOSPERM)* in LanguaL 2008."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03420208> "seed, skin removed, germ removed (endosperm)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03420208> <http://purl.obolibrary.org/obo/FOODON_03420134>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03420218> (animal organ by physiological system)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03420218> "Edible organ meat, including blood and bone marrow."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03420218> <http://www.langual.org/langual_thesaurus.asp?termid=C0218>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03420218> <http://www.langual.org/langual_thesaurus.asp?termid=C0255>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03420218> "animal organ by physiological system"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03420218> <http://purl.obolibrary.org/obo/FOODON_00004436>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03420228> (extract, concentrate or isolate of plant or animal)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03420228> "A physical-chemical component separated from the food source or its parts by extraction, centrifugation, filtration, heat processing, expressing or a similar process. The separated component may be converted through further processing. If this is done, the final substance is indexed. A water-extracted component may remain in aqueous dispersion. The extract, concentrate or isolate is indexed in preference to the anatomic part from which it is derived. For example, peanut oil is indexed under *PEANUT* combined wih *FAT OR OIL* rather than with *SEED OR KERNEL*. On the other hand, fruit and vegetable juices can be indexed under *FRUIT JUICE OR NECTAR* or *VEGETABLE JUICE* (A. PRODUCT TYPE); therefore the anatomic part of the plant should be indexed."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03420228> "langual:C0228")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03420228> "Damion Dooley's note: Items in this branch will be merged into foodon food product branch."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03420228> "extract, concentrate or isolate of plant or animal"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03420228> <http://purl.obolibrary.org/obo/FOODON_00001714>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03420229> (fruit, peel removed, core, pit or seed removed)

AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03420229> <http://www.langual.org/langual_thesaurus.asp?termid=C0229>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03420229> "LanguaL curation note: Renamed from *FRUIT OR BERRY, PEEL REMOVED, CORE, PIT OR SEED REMOVED* in LanguaL 2008."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03420229> "fruit, peel removed, core, pit or seed removed"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03420229> <http://purl.obolibrary.org/obo/FOODON_03420138>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03420238> (root, tuber or bulb)

AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03420238> <http://www.langual.org/langual_thesaurus.asp?termid=C0238>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03420238> "root, tuber or bulb"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03420238> <http://purl.obolibrary.org/obo/FOODON_03420148>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03420245> (mammalian milk curd)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03420245> "The thicker or more coagulable part of milk that is separated from the serum or watery part (whey), especially in the process of making cheese."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03420245> <http://www.langual.org/langual_thesaurus.asp?termid=C0245>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FOODON_03420245> "curd"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03420245> "mammalian milk curd"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03420245> <http://purl.obolibrary.org/obo/FOODON_03315150>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03420288> (seed bran)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03420288> "The broken outer coat, or husk, of grains of wheat, rye, oats, etc. separated from the flour after grinding, as by sifting (Source: Webster's)"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03420288> "LANGUAL:C0288"^^rdfs:Literal)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03420288> "seed bran"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03420288> <http://purl.obolibrary.org/obo/FOODON_03420178>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03420307> (seed oil)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03420307> "The oil produced by pressing or extracting lipids from plant seeds (e.g. grapeseed oil, rapeseed oil, linseed oil) /AM"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03420307> <http://www.langual.org/langual_thesaurus.asp?termid=C0307>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03420307> "seed oil"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03420307> <http://purl.obolibrary.org/obo/FOODON_00001087>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03430102> (food (liquid, high viscosity))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03430102> "A liquid that flows slowly at room temperature."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03430102> <http://www.langual.org/langual_thesaurus.asp?termid=E0102>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03430102> "Examples are: some heavy liqueurs, evaporated milk, vegetable oil, molasses and honey. The range of high viscosity liquids spans sucrose solutions between 45 and 70% solids (viscosity range from 10 to 500 centipoise). Prefer 'solid pieces' factor term to 'small particles' if both appear in the food."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03430102> "food (liquid, high viscosity)"@en)
EquivalentClasses(<http://purl.obolibrary.org/obo/FOODON_03430102> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/FOODON_03430130> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000086> <http://purl.obolibrary.org/obo/PATO_0001693>)))
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03430102> <http://purl.obolibrary.org/obo/FOODON_03430130>)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03430102> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000086> <http://purl.obolibrary.org/obo/PATO_0001693>))
DisjointClasses(<http://purl.obolibrary.org/obo/FOODON_03430102> <http://purl.obolibrary.org/obo/FOODON_03430109>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03430106> (finely ground)

AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03430106> <http://www.langual.org/langual_thesaurus.asp?termid=E0106>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03430106> "finely ground"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03430106> <http://purl.obolibrary.org/obo/FOODON_03430136>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03430109> (food (liquid, low viscosity))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03430109> "A liquid that flows very easily at room temperature."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03430109> <http://www.langual.org/langual_thesaurus.asp?termid=E0109>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03430109> "Examples are: water, apple juice, sherry, acidophilus milk, whipping cream and some heavy liqueurs. The range of low viscosity liquid spans sucrose solutions between 0 and 45% solids (viscosity range from 1 to 10 centipoise). Prefer 'solid pieces' factor term to 'small particles' if both appear in the food."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03430109> "food (liquid, low viscosity)"@en)
EquivalentClasses(<http://purl.obolibrary.org/obo/FOODON_03430109> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/FOODON_03430130> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000086> <http://purl.obolibrary.org/obo/PATO_0001694>)))
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03430109> <http://purl.obolibrary.org/obo/FOODON_03430130>)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03430109> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000086> <http://purl.obolibrary.org/obo/PATO_0001694>))

# Class: <http://purl.obolibrary.org/obo/FOODON_03430113> (food physical quality)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03430113> "The physical state of the food product (liquid, semiliquid, semisolid, or solid). Solid food products are further subdivided by shape or form. Terms are provided for products that have both liquid and solid components or that incorporate air or other gases. [FDA CFSAN 1995]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03430113> <http://www.langual.org/langual_thesaurus.asp?termid=E0113>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03430113> "Damion Dooley's note: these categories need to be mapped over to PATO phenotypic categories, with a suitable treatment of mixtures of solids that are divided into parts."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03430113> "food physical quality"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03430113> <http://purl.obolibrary.org/obo/FOODON_00002470>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03430122> (divided or disintegrated)

AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03430122> <http://www.langual.org/langual_thesaurus.asp?termid=E0122>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03430122> "LanguaL curation note: The distinctions in this category are based on size characteristics, primarily thickness, which are important for heat transfer and for diffusion of chemicals in processing. *DIVIDED INTO HALVES, QUARTERS OR SEGMENTS* should be examined first and if one of the descriptors listed applies it should be used regardless of the size of the pieces. If none of these are applicable, other *DIVIDED OR DISINTEGRATED* descriptors should be examined. Do not use any of these descriptors if dividing or disintegrating results in a semiliquid or semisolid product."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03430122> "divided or disintegrated"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03430122> <http://purl.obolibrary.org/obo/FOODON_03430113>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03430130> (food (liquid))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03430130> "A state of matter between a solid and a gas, in which a substance has the capacity to flow and conforms to the shape of the container."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03430130> <http://www.langual.org/langual_thesaurus.asp?termid=E0130>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03430130> <https://bioregistry.io/reference/siren:F5105>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03430130> "Liquids range from water to honey, corresponding to a range in viscosity (or apparent viscosity) from 1 to 500 centipoise (viscosity is a measure of a liquid's resistance to flow). Products that are pourable but have a higher viscosity are *SEMILIQUID*."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03430130> "food (liquid)"@en)
EquivalentClasses(<http://purl.obolibrary.org/obo/FOODON_03430130> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/FOODON_00002454> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000086> <http://purl.obolibrary.org/obo/PATO_0001548>)))
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03430130> <http://purl.obolibrary.org/obo/FOODON_00002454>)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03430130> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000086> <http://purl.obolibrary.org/obo/PATO_0001548>))

# Class: <http://purl.obolibrary.org/obo/FOODON_03430131> (whole)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03430131> "Refers to natural or formed shape as appropriate, regardless of size, which may vary from very large (e.g., beef carcass) to very small (e.g., poppy seed, yeast cell)."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03430131> <http://www.langual.org/langual_thesaurus.asp?termid=E0131>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03430131> "whole"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03430131> <http://purl.obolibrary.org/obo/FOODON_03430113>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03430136> (disintegrated or ground)

AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03430136> <http://www.langual.org/langual_thesaurus.asp?termid=E0136>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03430136> "LanguaL curation note: Used when particle size is below 0.2 cm."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03430136> "disintegrated or ground"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03430136> <http://purl.obolibrary.org/obo/FOODON_03430122>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03430150> (whole, natural shape)

AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03430150> <http://www.langual.org/langual_thesaurus.asp?termid=E0150>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03430150> "LanguaL curation note: Whole refers not only to a whole plant or animal but also to a whole part as indexed in C. PART OF PLANT OR ANIMAL; examples of whole natural products are: an apple, rice in grain form, an asparagus spear, a spinach leaf, a beef carcass, a dressed chicken, a chicken drumstick, a calf liver. Products may have been slightly modified during processing and preservation (e.g., raisins or a pear that has been peeled and cored)."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03430150> "whole, natural shape"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03430150> <http://purl.obolibrary.org/obo/FOODON_03430131>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03430151> (food (solid))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03430151> "Food material which is a hard or soft material capable of retaining its own shape at room temperature."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03430151> <http://www.langual.org/langual_thesaurus.asp?termid=E0151>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03430151> <https://bioregistry.io/reference/siren:F17643>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03430151> "A soft product that is spreadable or formable is considered semisolid.  Room temperature is roughly 20 degrees C."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03430151> "food (solid)"@en)
EquivalentClasses(<http://purl.obolibrary.org/obo/FOODON_03430151> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/FOODON_00002454> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000086> <http://purl.obolibrary.org/obo/PATO_0001546>)))
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03430151> <http://purl.obolibrary.org/obo/FOODON_00002454>)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03430151> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000086> <http://purl.obolibrary.org/obo/PATO_0001546>))

# Class: <http://purl.obolibrary.org/obo/FOODON_03450002> (food cooking)

AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03450002> "http://www.langual.org/langual_thesaurus.asp?termid=G0002")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03450002> "food cooking"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03450002> <http://purl.obolibrary.org/obo/FOODON_03460111>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03450004> (cooking by dry heat)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03450004> "Cooked at moderate to high levels of heat in which no liquid is added and only small amounts of fat may be added to prevent sticking."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03450004> "http://www.langual.org/langual_thesaurus.asp?termid=G0004")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03450004> "LanguaL"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03450004> "cooking by dry heat"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03450004> <http://purl.obolibrary.org/obo/FOODON_03450002>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03450005> (food baking)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03450005> "Cooked without moisture, covered or uncovered, in an oven."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03450005> "http://www.langual.org/langual_thesaurus.asp?termid=G0005")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03450005> "food baking"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03450005> <http://purl.obolibrary.org/obo/FOODON_03450004>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03460111> (food treatment process)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03460111> "Used to specifically characterize a food product based on the treatment or processes applied to the product or any indexed ingredient. The processes include adding, substituting or removing components or modifying the food or component, e.g., through fermentation."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03460111> "http://www.langual.org/langual_thesaurus.asp?termid=H0111")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03460111> "LanguaL curation note: This term is for CLASSIFICATION ONLY; DO NOT USE term in indexing. Use a more precise narrower term."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03460111> "food treatment process"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03460111> <http://purl.obolibrary.org/obo/FOODON_00002451>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03460119> (microbial/enzymatic modification process)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03460119> "A food modification process by microbial or enzymatic action which results in molecular changes in any food component."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03460119> "http://www.langual.org/langual_thesaurus.asp?termid=H0119")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03460119> "LanguaL curation note: If salt, sugar or other food additive is used to aid in the modification process, index it by the appropriate term under *INGREDIENT ADDED*."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03460119> "microbial/enzymatic modification process"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03460119> <http://purl.obolibrary.org/obo/FOODON_03460141>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03460130> (physical/chemical modification process)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03460130> "A food modification process where physical or chemical changes are effected in any food ingredient through a physical or non-enzymatic chemical process."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03460130> "http://www.langual.org/langual_thesaurus.asp?termid=H0130")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03460130> "physical/chemical modification process"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03460130> <http://purl.obolibrary.org/obo/FOODON_03460141>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03460141> (food modification process)

AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03460141> "http://www.langual.org/langual_thesaurus.asp?termid=H0141")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03460141> "LanguaL curation note: Used when the food product underwent mechanical, chemical or enzymatic modification that has affected the texture, flavor or other characteristic of the product."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03460141> "food modification process"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03460141> <http://purl.obolibrary.org/obo/FOODON_03460111>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03460161> (fat removal process)

AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03460161> "http://www.langual.org/langual_thesaurus.asp?termid=H0161")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03460161> "LanguaL curation note: Used for products that contain less than 60% of the fat naturally present in the food source (more precisely, the part of the food source.) more specific fat levels, which vary from one product type to another, are specified in the extended scope notes for *FAT PARTIALLY REMOVED* and *FAT FULLY REMOVED* in the manual."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03460161> "fat removal process"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03460161> <http://purl.obolibrary.org/obo/FOODON_03460238>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03460177> (plant seed or nut food product)

AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03460177> "langual:H0177")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03460177> "LanguaL curation note: With the exception of peanut (see *PEANUT OR PEANUT BUTTER ADDED*), used when a nut or seed ingredient is the second ingredient in order of predominance."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03460177> "plant seed or nut food product"@en)
EquivalentClasses(<http://purl.obolibrary.org/obo/FOODON_03460177> ObjectUnionOf(<http://purl.obolibrary.org/obo/FOODON_00001172> <http://purl.obolibrary.org/obo/FOODON_00001173>))
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03460177> <http://purl.obolibrary.org/obo/FOODON_00001015>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03460207> (food filling process)

AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03460207> "http://www.langual.org/langual_thesaurus.asp?termid=H0207")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03460207> "LanguaL curation note: Applies to all filled or stuffed products, including pies and sandwiches."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03460207> "food filling process"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03460207> <http://purl.obolibrary.org/obo/FOODON_03460130>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03460230> (single component food fermentation)

AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03460230> "http://www.langual.org/langual_thesaurus.asp?termid=H0230")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03460230> "LanguaL curation note: Used for products in which either carbohydrates, proteins or fats were modified through microbial processes. Enzymatic or other biological processes may also be involved. If two or more of these components are modified in significant amounts, index under *FERMENTED/MODIFIED, MULTIPLE COMPONENT*."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03460230> "single component food fermentation"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03460230> <http://purl.obolibrary.org/obo/FOODON_00001304>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03460238> (food component separation process)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03460238> "A component separation process at the very least removes one component from an initial entity.  The removed component may be captured as a process output for reuse if not destroyed in the process of removal."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03460238> "http://www.langual.org/langual_thesaurus.asp?termid=H0238")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03460238> "LanguaL curation note: Use the appropriate term under *COMPONENT REMOVED* to indicate the permanent full or partial removal of a nutritional/chemical component naturally present in the part of plant or animal used."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03460238> "food component separation process"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03460238> <http://purl.obolibrary.org/obo/FOODON_03460111>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03460248> (full fat removal process)

AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03460248> "http://www.langual.org/langual_thesaurus.asp?termid=H0248")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03460248> "LanguaL curation note: Used for products that contain less than 10-20% of the fat naturally present in the food source. Examples are skim milk, low-fat cocoa and dry-curd cottage cheese."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03460248> "full fat removal process"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03460248> <http://purl.obolibrary.org/obo/FOODON_03460161>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03460256> (carbohydrate fermentation)

AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03460256> "http://www.langual.org/langual_thesaurus.asp?termid=H0256")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03460256> "carbohydrate fermentation"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03460256> <http://purl.obolibrary.org/obo/FOODON_03460230>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03460263> (vegetable fat or oil)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03460263> "A fat or oil derived from vegetable material"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03460263> "langual:H0263")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03460263> "This is a convenience class inherited from LanguaL"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03460263> "vegetable fat or oil"@en)
EquivalentClasses(<http://purl.obolibrary.org/obo/FOODON_03460263> ObjectUnionOf(<http://purl.obolibrary.org/obo/FOODON_00001087> <http://purl.obolibrary.org/obo/FOODON_03316694>))
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03460263> <http://purl.obolibrary.org/obo/FOODON_00001174>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03460364> (dried or candied fruit)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03460364> "A convenience class for food indexers that encompases dried or candied fruit products."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03460364> "langual:H0364")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03460364> "dried or candied fruit"@en)
EquivalentClasses(<http://purl.obolibrary.org/obo/FOODON_03460364> ObjectUnionOf(<http://purl.obolibrary.org/obo/FOODON_03305040> <http://purl.obolibrary.org/obo/FOODON_03305656>))
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03460364> <http://purl.obolibrary.org/obo/FOODON_03315615>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03460748> (mammalian milk protein)

AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03460748> <http://www.langual.org/langual_thesaurus.asp?termid=H0748>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FOODON_03460748> "milk protein"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03460748> "mammalian milk protein"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03460748> <http://purl.obolibrary.org/obo/FOODON_03315150>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03470107> (food preservation process)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03470107> "The methods contributing to the prevention or retardation of microbial, enzymatic or oxidative spoilage and thus to the extension of shelf life. Index all methods for which information is available, even if a corresponding descriptor has already been used in *H. TREATMENT APPLIED*. Preservation descriptors refer to the finished food as a whole with these exceptions: (1) if the components of a multi-component food, such as cream pie, are preservation by different methods, index all methods; (2)  if chemical preservatives are declared on the label, always index them even if it is known that the preservative was introduced through or is only present in a component or ingredient of the food; and (3) if the preservation method for an ingredient is declared on the label (such as brie cheese made from pasteurized milk) index it. Also use *INGREDIENT preservation by THERMAL PROCESSING* or *INGREDIENT preservation by IRRADIATION* when ingredients have been pasteurized, ultrapasteurized, sterilized or irradiated."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03470107> "http://www.langual.org/langual_thesaurus.asp?termid=J0107")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03470107> "LanguaL curation note: This term is for CLASSIFICATION ONLY; DO NOT USE term in indexing. Use a more precise narrower term."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03470107> "food preservation process"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03470107> <http://purl.obolibrary.org/obo/FOODON_03460111>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03470116> (dehydration or drying)

AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03470116> "http://www.langual.org/langual_thesaurus.asp?termid=J0116")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FOODON_03470116> "dehydration"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FOODON_03470116> "drying"@en)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03470116> "LanguaL curation note: Used when the water activity has been lowered enough to achieve preservation. Also index *WATER REMOVED* in *H. TREATMENT APPLIED*."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03470116> "dehydration or drying"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03470116> <http://purl.obolibrary.org/obo/FOODON_00002419>)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03470116> <http://purl.obolibrary.org/obo/FOODON_03470145>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03470145> (preservation by reducing water activity)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03470145> "Preservation method that lowers the water activity (relative humidity) of a food product. This is accomplished by using mechanical dehydration equipment, by natural drying, by adding salt, sugar or other agents to the food or by surface drying during a refrigeration or freezing operation. This method of preservation may be used in conjunction with other preservation methods such as preservation by thermal processing."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03470145> "http://www.langual.org/langual_thesaurus.asp?termid=J0145")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03470145> "preservation by reducing water activity"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03470145> <http://purl.obolibrary.org/obo/FOODON_03470107>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03510021> (animal as food consumer)

AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03510021> <http://www.langual.org/langual_thesaurus.asp?termid=P0021>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03510021> "animal as food consumer"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03510021> <http://purl.obolibrary.org/obo/FOODON_03510136>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03510023> (dietary claim)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03510023> "Renamed from *FOOD FOR SPECIAL DIETARY USE* [LanguaL 2008].

These descriptors are used either for foods intended for special dietary use as defined in 21 CFR 105 or for foods that have special characteristics indicated in the name or labeling. Such claims would include 'low calorie', 'low cholesterol', 'diet' or 'dietetic', etc. Prior to february 1992, this category of descriptors was limited solely to food for adult humans. The category is now used in conjunction with any appropriate *CONSUMER GROUP* descriptor(s), for example, 'low sugar baby food' would be indexed by *INFANT OR TODDLER FOOD* as well as by *LOW SUGARS FOOD*."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03510023> <http://www.langual.org/langual_thesaurus.asp?termid=P0023>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03510023> <http://www.langual.org/langual_thesaurus.asp?termid=P0032>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03510023> "dietary claim"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03510023> <http://purl.obolibrary.org/obo/FOODON_03602001>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03510048> (high fiber food)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03510048> "A claim that a food is high in fibre, and any claim likely to have the same meaning for the consumer, may only be made where the product contains at least 6 g of fibre per 100 g or at least 3 g of fibre per 100 kcal [REGULATION (EC) No 1924/2006 Corrigendum 2007-01-18].

Food that is promoted as a source of or as high in dietary fiber (often called simply 'fiber')."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03510048> <http://www.langual.org/langual_thesaurus.asp?termid=P0048>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03510048> "high fiber food"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03510048> <http://purl.obolibrary.org/obo/FOODON_03510049>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03510049> (fiber special claim)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03510049> "Food that is promoted as being either high or low in dietary fiber (often called simply 'fiber'). If the food is not low in total fat, total fat must be stated in conjunction with claim such as 'more fiber'."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03510049> <http://www.langual.org/langual_thesaurus.asp?termid=P0049>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03510049> "fiber special claim"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03510049> <http://purl.obolibrary.org/obo/FOODON_03510065>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03510065> (nutrition-related claim)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03510065> "As defined in Corrigendum to Regulation (EC) No 1924/2006 of the European Parliament and of the Council of 20 December 2006 on nutrition and health claims made on foods, \"claim\" means any message or representation, which is not
mandatory under Community or national legislation, including pictorial, graphic or symbolic representation, in any form, which states, suggests or implies that a food has particular characteristics; specificly, \"nutrition claim\"means any claim which states, suggests or implies that a food has particular beneficial nutritional properties
due to:

(a) the energy (calorific value) it (i) provides; (ii) provides at a reduced or increased rate; or (iii) does not provide;

and/or

(b) the nutrients or other substances it (i) contains; (ii) contains in reduced or  increased proportions; or (iii) does not contain."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03510065> <http://www.langual.org/langual_thesaurus.asp?termid=P0065>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03510065> "LanguaL curation note: Used for  any claim which states, suggests or implies that a food has particular beneficial nutritional properties.

For European regulations, see http://ec.europa.eu/food/food/labellingnutrition/claims/community_register/nutrition_claims_en.htm"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03510065> "nutrition-related claim"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03510065> <http://purl.obolibrary.org/obo/FOODON_03510023>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03510136> (food consumer group)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03510136> "A food consumer group is a class of organism based on their heterotrophic requirements or preferences."@en)
