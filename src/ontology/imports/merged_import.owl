AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01000769> "Requested for SDGIO. This class may be revised in future once the offical definitions become more clear.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000769> "carbon dioxide emission process"@en)
