AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_01001135> "dry planet")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01001135> "This class of planet is still mostly theoretical.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01001135> "desert planet"@en)
EquivalentClasses(<http://purl.obolibrary.org/obo/ENVO_01001135> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/ENVO_01000958> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/ENVO_01000324> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002473> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/ENVO_01001357> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000086> <http://purl.obolibrary.org/obo/PATO_0001305>)))))))
