SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_78420> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000087> <http://purl.obolibrary.org/obo/CHEBI_71942>))
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_78420> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000087> <http://purl.obolibrary.org/obo/CHEBI_76989>))

