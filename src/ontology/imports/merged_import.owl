SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_82644> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <http://purl.obolibrary.org/obo/CHEBI_82649>))
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_82644> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <http://purl.obolibrary.org/obo/CHEBI_82652>))
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_82644> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <http://purl.obolibrary.org/obo/CHEBI_82653>))
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_82644> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000087> <http://purl.obolibrary.org/obo/CHEBI_35522>))
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_82644> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000087> <http://purl.obolibrary.org/obo/CHEBI_82655>))

