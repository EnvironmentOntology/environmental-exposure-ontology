AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03420134> "LanguaL curation note: Renamed from *SEED OR KERNEL, SKIN REMOVED* in LanguaL 2008."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03420134> "seed, skin removed"@en)
