AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000705> "soil degradation"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000705> <http://purl.obolibrary.org/obo/ENVO_02500005>)

