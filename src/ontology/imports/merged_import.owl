SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_72564> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000087> <http://purl.obolibrary.org/obo/CHEBI_22587>))
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_72564> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000087> <http://purl.obolibrary.org/obo/CHEBI_35610>))
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_72564> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000087> <http://purl.obolibrary.org/obo/CHEBI_50266>))

