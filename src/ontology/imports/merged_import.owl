SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000769> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002418> <http://purl.obolibrary.org/obo/ENVO_02500004>))

# Class: <http://purl.obolibrary.org/obo/ENVO_01000773> (village)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Village") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000773> "A village is a clustered human settlement or community, larger than a hamlet but smaller than a town, with a population ranging from a few hundred to a few thousand. Though often located in rural areas, the term urban village is also applied to certain urban neighbourhoods. Villages are normally permanent, with fixed dwellings; however, transient villages can occur. Further, the dwellings of a village are fairly close to one another, not scattered broadly over the landscape, as a dispersed settlement.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000773> "village"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000773> <http://purl.obolibrary.org/obo/ENVO_01001829>)

