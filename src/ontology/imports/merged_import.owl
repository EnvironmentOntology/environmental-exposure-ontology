# Class: <http://purl.obolibrary.org/obo/ENVO_01000743> (land consumption process)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Adapted from EEA (1997) The concept of environmental space, Copenhagen, URL: http://www.eea.europa.eu/publications/92-9167-078-2/at_download/file") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000743> "A process in which natural ecosystems present over an expanse of land are removed and replaced with anthropogenic ecosystems.")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01000743> "These anthropogenic ecosystems may include urban or other built-up settlements or anthropogenic ecosystems used for activities such as forestry or agriculture.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000743> "land consumption process"@en)
