AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Concrete") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000458> "Concrete is a composite material composed of an aggregate bonded together with a fluid cement which hardens over time.")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01000458> "Missing the class for \"aggregate\" - tricky to define what it is, exactly. Again, seems more like some sort of material/disposition hybrid.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000458> "concrete")
