SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000815> <http://purl.obolibrary.org/obo/ENVO_02000140>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01000817> (biosphere)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.biology-online.org/dictionary/Biosphere") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Biosphere") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000817> "An astronomical body part which includes all the living entities within the gravitational sphere of influence of that body, as well as the non-living and dead entities with which they interact."@en)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01000817> "The gravitational sphere of influence referenced in this class' definition is the Hill sphere: a region in which an object dominates the attraction of satellites despite gravitational perturbations.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000817> "biosphere"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000817> <http://purl.obolibrary.org/obo/ENVO_01000813>)

