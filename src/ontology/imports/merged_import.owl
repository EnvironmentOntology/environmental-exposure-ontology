SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01001431> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectUnionOf(<http://purl.obolibrary.org/obo/ENVO_01000743> <http://purl.obolibrary.org/obo/ENVO_01001429> <http://purl.obolibrary.org/obo/ENVO_02500005>)))

# Class: <http://purl.obolibrary.org/obo/ENVO_01001433> (terrestrial mining)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://assets.publishing.service.gov.uk/government/uploads/system/uploads/attachment_data/file/11493/144275.pdf") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Land_use") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Mining") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.eionet.europa.eu/gemet/en/concept/14837") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01001433> "A land use process during which materials of economic value are extracted from a planet, usually from an orebody, lode, vein, seam, reef or placer deposit.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01001433> "terrestrial mining"@en)
EquivalentClasses(<http://purl.obolibrary.org/obo/ENVO_01001433> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/ENVO_01001437> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000057> ObjectUnionOf(<http://purl.obolibrary.org/obo/ENVO_00000446> <http://purl.obolibrary.org/obo/ENVO_01000635> <http://purl.obolibrary.org/obo/ENVO_01001226>))))
