AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MAXO_0000744> "postmenopausal hormone therapy")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MAXO_0000744> "menopausal hormone therapy"@en)
SubClassOf(<http://purl.obolibrary.org/obo/MAXO_0000744> <http://purl.obolibrary.org/obo/MAXO_0000282>)

