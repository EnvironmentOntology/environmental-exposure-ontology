AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FOODON_00002403> "food"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FOODON_00002403> "foodstuff"@en)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_00002403> "This class is the top of FOODON's main food product hierarchy which is described in the https://www.foodon.org website, and can be searched in lookup services like https://www.ebi.ac.uk/ols/"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_00002403> "food material"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_00002403> <http://purl.obolibrary.org/obo/BFO_0000040>)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_00002403> <http://purl.obolibrary.org/obo/ENVO_00010483>)

# Class: <http://purl.obolibrary.org/obo/FOODON_00002407> (thickness of 1.5 cm to less than 7.0 cm)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_00002407> "A material entity having a thickness of 1.5 to less than 7.0 cm"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_00002407> "thickness of 1.5 cm to less than 7.0 cm"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_00002407> <http://purl.obolibrary.org/obo/PATO_0000915>)

# Class: <http://purl.obolibrary.org/obo/FOODON_00002414> (food solvent extraction)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_00002414> "Extraction of substance(s) from a food source using a solvent such as alcohol, hexane, or ethanol."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_00002414> "food solvent extraction"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_00002414> <http://purl.obolibrary.org/obo/FOODON_03460130>)

# Class: <http://purl.obolibrary.org/obo/FOODON_00002419> (food evaporation process)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_00002419> "A food evaporation process is the process of removing water from a food."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_00002419> "food evaporation process"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_00002419> <http://purl.obolibrary.org/obo/FOODON_03460130>)

