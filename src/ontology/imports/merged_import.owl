# Class: <http://purl.obolibrary.org/obo/ENVO_01000687> (coast)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Coast") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000687> "A coast is the area where land meets the sea, ocean, or lake.")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01000687> "Used for both marine and lake coasts. The boundary of the coast is fuzzy and it overlaps both the water body and land in quesiton. Compared to 'shore'")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000687> "coast"@en)
EquivalentClasses(<http://purl.obolibrary.org/obo/ENVO_01000687> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/ENVO_01001784> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002131> <http://purl.obolibrary.org/obo/ENVO_01000635>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002131> ObjectUnionOf(<http://purl.obolibrary.org/obo/ENVO_00000015> <http://purl.obolibrary.org/obo/ENVO_00000016> <http://purl.obolibrary.org/obo/ENVO_00000020>))))
