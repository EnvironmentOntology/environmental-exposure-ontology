AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/UBERON_0000440> "UBERON:0000440")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UBERON_0000440> "trabecula")
SubClassOf(<http://purl.obolibrary.org/obo/UBERON_0000440> <http://purl.obolibrary.org/obo/UBERON_0000064>)
