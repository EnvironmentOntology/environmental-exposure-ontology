SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000678> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000057> <http://purl.obolibrary.org/obo/ENVO_01000669>))
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000678> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002427> <http://purl.obolibrary.org/obo/ENVO_01001093>))

