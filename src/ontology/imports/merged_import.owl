AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000665> "waste role"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000665> <http://purl.obolibrary.org/obo/BFO_0000023>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01000667> (geological fracture)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Fracture_(geology)") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000667> "A geological fracture is any separation in a geologic formation, such as a joint or a fault that divides a mass of rock into two or more pieces.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/ENVO_01000667> "SWEETRealm:Fissure")
