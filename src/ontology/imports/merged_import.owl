# Class: <http://purl.obolibrary.org/obo/ENVO_01001486> (landspout)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Tornado") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01001486> "A tornado which a) is not associated with a mesocyclone and is thus relatively weak and short-lived, b) is centred on a small, smooth condensation funnel which often does not reach the planetary surface, and c) forms a distinctively laminar cloud of dust when it makes contact with the land."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_01001486> "dust-tube tornado"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_01001486> "fair weather waterspout on land"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_01001486> "land spout"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01001486> "landspout"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01001486> <http://purl.obolibrary.org/obo/ENVO_01001482>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01001487> (waterspout)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Tornado") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01001487> "A tornado which connects a cumulus or cumulonimbus cloud to a body of water, often transporting water from that water body along the spiraling winds constituting  its vortex."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_01001487> "water spout"@en)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01001487> "Wikipedia notes that there is disagreement over whether to classify waterspouts as true tornadoes."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01001487> "waterspout"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01001487> <http://purl.obolibrary.org/obo/ENVO_01001482>)
