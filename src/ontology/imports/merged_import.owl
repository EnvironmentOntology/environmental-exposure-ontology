AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_01000479> "slaked lime plaster")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000479> "lime plaster")
