# Class: <http://purl.obolibrary.org/obo/ENVO_01000786> (fire)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.eionet.europa.eu/gemet/en/concept/3212") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Fire") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000786> "A fire is a process whereby rapid and exothermic oxidation of a material through a combustion process releases heat, light, and other products.")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01000786> "Not to be confused with a flame - the visible portion of gas released by a fire . Oxidation processes such as rusting or biological digestion are not subsumed here.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000786> "fire"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000786> <http://purl.obolibrary.org/obo/ENVO_01000839>)

