# Class: <http://purl.obolibrary.org/obo/ENVO_01000829> (water vapour saturated air)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000829> "Air which has a partial pressure of water vapour equal or near equal to its equilibrium vapor pressure at a given temperature.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_01000829> "water-vapour-saturated air")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01000829> "\"Near equal\" is meant to reflect that there will be fluctuations around the equilibrium point.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000829> "water vapour saturated air"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000829> <http://purl.obolibrary.org/obo/ENVO_01000828>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01000830> (water-based rainfall)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Rain") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000830> "A hydrological precipitation process in which atmospheric water vapour condenses to form droplets of liquid water massive enough to fall to a planetary surface due to the planet's gravity.")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01000830> "This is the process which typically happens on Earth. Other planets may have different liquids involved in the process.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000830> "water-based rainfall"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000830> <http://purl.obolibrary.org/obo/ENVO_01000703>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000830> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000057> <http://purl.obolibrary.org/obo/ENVO_01000829>))
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000830> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000057> <http://purl.obolibrary.org/obo/ENVO_01000832>))

# Class: <http://purl.obolibrary.org/obo/ENVO_01000831> (droplet)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://en.wikipedia.org/wiki/Drop_%28liquid%29>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000831> "A droplet is a small column of liquid, bounded completely or almost completely by free surfaces which maintains its shape due to the surface tension of the liquid.")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01000831> "No attempt is made to differentiate between drops and droplets. This may be added, if requested.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000831> "droplet"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000831> <http://purl.obolibrary.org/obo/ENVO_01001690>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01000832> (raindrop)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000832> "A droplet formed by condensation of vapour in an atmosphere and which is sufficiently massive to overcome atmospheric resistance and fall to a planetary surface due to gravity.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000832> "raindrop"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000832> <http://purl.obolibrary.org/obo/ENVO_01000831>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000832> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002354> <http://purl.obolibrary.org/obo/ENVO_01000724>))

# Class: <http://purl.obolibrary.org/obo/ENVO_01000833> (water droplet)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000833> "A droplet of water")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000833> "water droplet"@en)
EquivalentClasses(<http://purl.obolibrary.org/obo/ENVO_01000833> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/ENVO_01000831> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002473> <http://purl.obolibrary.org/obo/ENVO_00002006>)))
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000833> <http://purl.obolibrary.org/obo/ENVO_01000831>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01000834> (water raindrop)

AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01000834> "This is the class intended for use when describing raindrops on Earth. These typically have a diamter of  0.1 to 9 millimetres.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000834> "water raindrop"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000834> <http://purl.obolibrary.org/obo/ENVO_01000832>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000834> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002473> <http://purl.obolibrary.org/obo/ENVO_00002006>))

# Class: <http://purl.obolibrary.org/obo/ENVO_01000835> (cloud droplet)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://en.wikipedia.org/wiki/Rain>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000835> "A droplet which is spherical in shape and suspended in an atmosphere, being of too small a mass to be pulled to a planetary surface by gravity.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000835> "cloud droplet"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000835> <http://purl.obolibrary.org/obo/ENVO_01000831>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01000836> (water-based cloud droplet)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000836> "A cloud droplet composed primarily of water.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_01000836> "water based cloud droplet")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000836> "water-based cloud droplet"@en)
EquivalentClasses(<http://purl.obolibrary.org/obo/ENVO_01000836> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/ENVO_01000835> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002473> <http://purl.obolibrary.org/obo/ENVO_00002006>)))
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000836> <http://purl.obolibrary.org/obo/ENVO_01000835>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000836> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002473> <http://purl.obolibrary.org/obo/ENVO_00002006>))

# Class: <http://purl.obolibrary.org/obo/ENVO_01000838> (smoke)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Smoke") rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01000838> "Smoke is a collection of airborne solid and liquid particulates and gases emitted when a material undergoes combustion or pyrolysis, together with the quantity of gas that is entrained or otherwise mixed into the mass")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000838> "smoke"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000838> <http://purl.obolibrary.org/obo/ENVO_00010505>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000838> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/ENVO_01000797> <http://purl.obolibrary.org/obo/ENVO_01000814> <http://purl.obolibrary.org/obo/ENVO_01000815>)))
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000838> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002354> <http://purl.obolibrary.org/obo/ENVO_01000839>))

# Class: <http://purl.obolibrary.org/obo/ENVO_01000839> (combustion process)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Combustion") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000839> "Combustion or burning is a high-temperature exothermic redox chemical reaction between a fuel and an oxidant that produces oxidized, often gaseous products, in a mixture termed as smoke.")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01000839> "Unlike the \"combustion\" class in the Chemical Methods Ontology, this class is not necessarily a planned process. http://purl.obolibrary.org/obo/CHMO_0001473")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000839> "combustion process"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000839> <http://purl.obolibrary.org/obo/ENVO_01000840>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000839> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002233> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/BFO_0000040> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000086> <http://purl.obolibrary.org/obo/PATO_0015021>))))
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000839> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002233> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/BFO_0000040> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000087> <http://purl.obolibrary.org/obo/CHEBI_33292>))))
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000839> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002234> <http://purl.obolibrary.org/obo/ENVO_01000838>))

# Class: <http://purl.obolibrary.org/obo/ENVO_01000840> (thermolysis)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000840> "A chemical decomposition (the separation of a single chemical compound into its two or more elemental parts or to simpler compounds) caused by heat.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_01000840> "thermal decomposition")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000840> "thermolysis"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000840> <http://purl.obolibrary.org/obo/ENVO_03000043>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01000841> (pyrolysis)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000841> "A thermolysis process in which organic material is decomposed in the absence of oxygen.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000841> "pyrolysis"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000841> <http://purl.obolibrary.org/obo/ENVO_01000840>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000841> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000066> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/ENVO_00010483> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000086> <http://purl.obolibrary.org/obo/PATO_0001456>))))
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000841> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000057> <http://purl.obolibrary.org/obo/ENVO_01000155>))
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000841> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002234> <http://purl.obolibrary.org/obo/ENVO_01000838>))

