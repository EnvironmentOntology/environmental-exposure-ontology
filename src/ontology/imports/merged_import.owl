AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "CALOHA:TS-0998") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/UBERON_0007616> "synovium")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/UBERON_0007616> "UBERON:0007616")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UBERON_0007616> "layer of synovial tissue")
