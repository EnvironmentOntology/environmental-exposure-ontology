AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03411601> "clupeiform fish"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03411601> <http://purl.obolibrary.org/obo/FOODON_00005727>)
