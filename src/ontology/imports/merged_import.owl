AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_21001214> "infra-red radiation")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_21001214> "infrared radiation")
