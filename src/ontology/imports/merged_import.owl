AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_03510001> "brake fluid"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_03510001> <http://purl.obolibrary.org/obo/ENVO_03510004>)

