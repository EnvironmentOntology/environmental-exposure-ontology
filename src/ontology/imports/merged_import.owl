# Class: <http://purl.obolibrary.org/obo/ENVO_01000640> (planetary mantle)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Mantle_(geology)") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000640> "A planetary mantle is a planetary layer which is an interior part of a terrestrial planet or other rocky body large enough to have differentiation by density.")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01000640> "This class is meant to be applicable accross planets. Earth's mantle would be an instance.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000640> "planetary mantle"@en)
