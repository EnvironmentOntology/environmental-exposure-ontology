AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/CHEBI_39024> "CHEBI:39024")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CHEBI_39024> "clathrate compound")
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_39024> <http://purl.obolibrary.org/obo/CHEBI_39022>)

# Class: <http://purl.obolibrary.org/obo/CHEBI_39025> (high-density lipoprotein)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CHEBI_39025> "A class of lipoproteins of small size (4-13 nm) and dense (greater than 1.063 g/ml) particles. They are synthesized in the liver without a lipid core, accumulate cholesterol esters from peripheral tissues and transport them to the liver for re-utilization or elimination from the body (the reverse cholesterol transport).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/CHEBI_39025> "CHEBI:39025")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CHEBI_39025> "high-density lipoprotein")
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_39025> <http://purl.obolibrary.org/obo/CHEBI_6495>)
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_39025> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <http://purl.obolibrary.org/obo/CHEBI_47775>))

# Class: <http://purl.obolibrary.org/obo/CHEBI_39026> (low-density lipoprotein)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CHEBI_39026> "A class of lipoproteins of small size (18-25 nm) and low density (1.019-1.063 g/ml) particles with a core composed mainly of cholesterol esters and smaller amounts of triglycerides. The surface monolayer consists mostly of phospholipids, a single copy of apolipoprotein B-100, and free cholesterol molecules. The main function of LDL is to transport cholesterol and cholesterol esters from the liver. Excessive levels are associated with cardiovascular disease.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/CHEBI_39026> "CHEBI:39026")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CHEBI_39026> "low-density lipoprotein")
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_39026> <http://purl.obolibrary.org/obo/CHEBI_6495>)
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_39026> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <http://purl.obolibrary.org/obo/CHEBI_47774>))

