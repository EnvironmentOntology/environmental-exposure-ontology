AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://vocab.lternet.edu/vocab/vocab/index.php?tema=962&/ocean-acidification") <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/ENVO_01000631> "LTER:962")
