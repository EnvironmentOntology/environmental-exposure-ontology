SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01001433> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectUnionOf(<http://purl.obolibrary.org/obo/ENVO_01000743> <http://purl.obolibrary.org/obo/ENVO_01001429> <http://purl.obolibrary.org/obo/ENVO_02500005>)))

# Class: <http://purl.obolibrary.org/obo/ENVO_01001434> (anthropogenic ecosystem conversion process)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01001434> "A process during which an ecosystem - natural or anthropised - is changed by the actions of humans.")
