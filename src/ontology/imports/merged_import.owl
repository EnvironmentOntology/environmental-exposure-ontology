InverseObjectProperties(<http://purl.obolibrary.org/obo/RO_0002219> <http://purl.obolibrary.org/obo/RO_0002221>)

# Object Property: <http://purl.obolibrary.org/obo/RO_0002220> (adjacent to)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/RO_0002220> "x adjacent to y if and only if x and y share a boundary.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/RO_0002220> "adjacent to"@en)
SubObjectPropertyOf(<http://purl.obolibrary.org/obo/RO_0002220> <http://purl.obolibrary.org/obo/RO_0002163>)
