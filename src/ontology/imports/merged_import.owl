AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_01001214> "infra-red stellar radiation")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01001214> "infrared stellar radiation"@en)
EquivalentClasses(<http://purl.obolibrary.org/obo/ENVO_01001214> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/ENVO_21001214> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002608> <http://purl.obolibrary.org/obo/ENVO_01000801>)))

