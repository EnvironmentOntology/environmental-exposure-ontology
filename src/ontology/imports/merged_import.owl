AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Coastal_flood") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000707> "Coastal flooding is a process in which normally dry, low-lying land near a coast is flooded by sea water.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000707> "coastal flooding"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000707> <http://purl.obolibrary.org/obo/ENVO_02500002>)
