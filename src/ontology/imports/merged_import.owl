# Class: <http://purl.obolibrary.org/obo/ENVO_01001437> (mining)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://assets.publishing.service.gov.uk/government/uploads/system/uploads/attachment_data/file/11493/144275.pdf") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Land_use") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Mining") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.eionet.europa.eu/gemet/en/concept/14837") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01001437> "A planned environmental usage process during which a non-renewable resource such as petroleum, natural gas, or water is extracted from an ecosystem.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01001437> "mining"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01001437> <http://purl.obolibrary.org/obo/ENVO_01001436>)
