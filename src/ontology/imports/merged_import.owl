AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0005577> "fibrinogen complex")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0005577> <http://purl.obolibrary.org/obo/GO_0140392>)

