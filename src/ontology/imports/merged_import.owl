AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_01000415> "PM2.5")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000415> "fine respirable suspended particulate matter"@en)
