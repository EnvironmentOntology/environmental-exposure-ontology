AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://en.wikipedia.org/wiki/Sand>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_00000340> "A particle which 1) is composed primarily of and derived from rock or mineral sources and 2) is or was part of a portion of sand."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_00000340> "grain of sand"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_00000340> "granule of sand"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_00000340> "sand granule"@en)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_00000340> "In general, sand grains are larger than those of silt, but finer than those of gravel."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_00000340> "particle of sand"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_00000340> <http://purl.obolibrary.org/obo/ENVO_01003002>)
