# Class: <http://purl.obolibrary.org/obo/ENVO_01001482> (tornado)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Tornado") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01001482> "A tornado is an aeroform consisting of at least one rapidly rotating column of air that is in contact with both the surface of an astronomical body and pendant from within or beneath a cumulonimbus or cumulus cloud."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_01001482> "twister"@en)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01001482> "This class refers to tornados on Earth, but can be used as the basis for a more generalised class for tornados which a composed of gaseous materials other than air."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01001482> "tornado"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01001482> <http://purl.obolibrary.org/obo/ENVO_01000755>)
