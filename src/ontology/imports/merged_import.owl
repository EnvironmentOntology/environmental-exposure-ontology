AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/CHEBI_35476> "CHEBI:35476")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CHEBI_35476> "antipsychotic agent")
