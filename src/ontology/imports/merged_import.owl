SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000797> <http://purl.obolibrary.org/obo/ENVO_02000140>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01000798> (plasma)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.merriam-webster.com/dictionary/plasma") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Plasma_%28physics%29") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000798> "A material entity which is composed of a volume of unbound positive and negative particles in roughly equal numbers, conducts electricity, and possesses internal magnetic fields.")
