AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/RO_0002244> "related via exposure to")
SubObjectPropertyOf(<http://purl.obolibrary.org/obo/RO_0002244> <http://purl.obolibrary.org/obo/RO_0002410>)

# Object Property: <http://purl.obolibrary.org/obo/RO_0002252> (connecting branch of)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/RO_0002252> "b connecting-branch-of s iff b is connected to s, and there exists some tree-like structure t such that the mereological sum of b plus s is either the same as t or a branching-part-of t.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/RO_0002252> "connecting branch of")
SubObjectPropertyOf(<http://purl.obolibrary.org/obo/RO_0002252> <http://purl.obolibrary.org/obo/RO_0002170>)
SubObjectPropertyOf(<http://purl.obolibrary.org/obo/RO_0002252> <http://purl.obolibrary.org/obo/RO_0002375>)
InverseObjectProperties(<http://purl.obolibrary.org/obo/RO_0002252> <http://purl.obolibrary.org/obo/RO_0002253>)

