AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MAXO_0000259> "therapeutic insulin therapy")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MAXO_0000259> "insulin treatment")
