SubClassOf(<http://purl.obolibrary.org/obo/ExO_0000000> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/exo#interacts_with_an_exposure_receptor_via> <http://purl.obolibrary.org/obo/ExO_0000002>))

