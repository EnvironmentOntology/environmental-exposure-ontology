AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/ExO_0000055> "ExO:0000055")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ExO_0000055> "exposure route")
SubClassOf(<http://purl.obolibrary.org/obo/ExO_0000055> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/ExO_0000002>))

