AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/RO_0002434> "interacts with")

# Object Property: <http://purl.obolibrary.org/obo/exo#interacts_with_an_exposure_receptor_via> (interacts_with_an_exposure_receptor_via)

AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/exo#interacts_with_an_exposure_receptor_via> "interacts_with_an_exposure_receptor_via")
