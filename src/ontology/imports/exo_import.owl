AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/ExO_0000001> "ExO:0000001")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ExO_0000001> "exposure recipient")
SubClassOf(<http://purl.obolibrary.org/obo/ExO_0000001> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002434> <http://purl.obolibrary.org/obo/ExO_0000000>))

