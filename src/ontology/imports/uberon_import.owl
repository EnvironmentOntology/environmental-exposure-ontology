# Class: <http://purl.obolibrary.org/obo/GO_0035990> (tendon cell differentiation)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "CL:0000388") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:yaf") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21412429") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/GO_0035990> "The process in which a relatively unspecialized cell acquires the specialized features of a tendon cell. Tendon cell are elongated fibrocytes in which the cytoplasm is stretched between the collagen fibres of the tendon. Tendon cells have a central cell nucleus with a prominent nucleolus, a well-developed rough endoplasmic reticulum, and are responsible for synthesis and turnover of tendon fibres and ground substance.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "CL:0000388") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/GO_0035990> "muscle attachment cell differentiation")
