AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UBERON_0011823> "dense connective tissue")
EquivalentClasses(<http://purl.obolibrary.org/obo/UBERON_0011823> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/UBERON_0002384> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002473> <http://purl.obolibrary.org/obo/UBERON_0011860>)))
