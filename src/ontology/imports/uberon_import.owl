AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PATO_0000025> "For example calcium composition (which may inhere in bone), haemoglobin composition (which may inhere in blood).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PATO_0000025> "composition")
SubClassOf(<http://purl.obolibrary.org/obo/PATO_0000025> <http://purl.obolibrary.org/obo/PATO_0000141>)

