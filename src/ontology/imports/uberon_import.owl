AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:NC_ratio&oldid=931936284") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://lymerick.net/blood-cells.pdf") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PATO_0040072> "A quality inhering in a cell by virtue of the cell having a high nuclear/cytoplasmic ratio.")
