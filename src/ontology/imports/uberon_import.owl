AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:aruk") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:bc") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:dgh") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:hb") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:mah") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21422226") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28096264") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/GO_0005911> "A cell junction that forms a connection between two or more cells of an organism; excludes direct cytoplasmic intercellular bridges, such as ring canals in insects.")
