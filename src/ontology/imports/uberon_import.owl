DisjointClasses(<http://purl.obolibrary.org/obo/GO_0005929> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002162> <http://purl.obolibrary.org/obo/NCBITaxon_4890>))
