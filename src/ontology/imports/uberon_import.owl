SubClassOf(<http://purl.obolibrary.org/obo/GO_0007154> <http://purl.obolibrary.org/obo/GO_0009987>)

# Class: <http://purl.obolibrary.org/obo/GO_0007163> (establishment or maintenance of cell polarity)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/GO_0007163> "Any cellular process that results in the specification, formation or maintenance of anisotropic intracellular organization or cell growth patterns.")
