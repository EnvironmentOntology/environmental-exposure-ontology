# Class: <http://purl.obolibrary.org/obo/UBERON_0006268> (notochordal process)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.med.umich.edu/lrc/coursepages/m1/embryology/embryo/05embryonicperiod.htm") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0006268> "A midline cellular cord formed from the migration of mesenchymal cells from the primitive knot.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0006268> "EHDAA2:0001279")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0006268> "EHDAA:224")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0006268> "EMAPA:16102")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0006268> "FMA:293135")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0006268> "NCIT:C34232")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0006268> "VHOG:0001213")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/UBERON_0006268> "UBERON:0006268")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/UBERON_0006268> "The notochordal process grows cranially until it reaches the prechordal plate, the future site of the mouth. In this area the ectoderm is attached directly to the endoderm without intervening mesoderm. This area is known as the oropharyngeal membrane, and it will break down to become the mouth. At the other end of the primitive streak the ectoderm is also fused directly to the endoderm; this is known as the cloacal membrane (proctodeum), or primordial anus.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UBERON_0006268> "notochordal process")
SubClassOf(<http://purl.obolibrary.org/obo/UBERON_0006268> <http://purl.obolibrary.org/obo/UBERON_0005423>)
