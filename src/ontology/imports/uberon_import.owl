AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GO_0009790> "GO:0009790")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0009790> "embryo development")
