AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PATO_0002318> "superelliptic")
SubClassOf(<http://purl.obolibrary.org/obo/PATO_0002318> <http://purl.obolibrary.org/obo/PATO_0002006>)

