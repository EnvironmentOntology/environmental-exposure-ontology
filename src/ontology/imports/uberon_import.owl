AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/CL_0002072> "myocytus nodalis")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CL_0002072> "nodal myocyte")
