AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/PATO_0040072> "PATO:0040072")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PATO_0040072> "A high nuclear/cytolasmic ratio is 70% or higher.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PATO_0040072> "high nuclear/cytoplasmic ratio")
SubClassOf(<http://purl.obolibrary.org/obo/PATO_0040072> <http://purl.obolibrary.org/obo/PATO_0001396>)

