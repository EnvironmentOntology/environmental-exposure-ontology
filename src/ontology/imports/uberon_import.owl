SubClassOf(<http://purl.obolibrary.org/obo/GO_0001840> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/GO_0043009>))
SubClassOf(<http://purl.obolibrary.org/obo/GO_0001840> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002162> <http://purl.obolibrary.org/obo/NCBITaxon_7711>))
SubClassOf(<http://purl.obolibrary.org/obo/GO_0001840> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002296> <http://purl.obolibrary.org/obo/UBERON_0003075>))

