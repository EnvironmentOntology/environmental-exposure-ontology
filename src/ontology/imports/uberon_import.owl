AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CL_0007004> "premigratory neural crest cell")
SubClassOf(<http://purl.obolibrary.org/obo/CL_0007004> <http://purl.obolibrary.org/obo/CL_0000255>)
SubClassOf(<http://purl.obolibrary.org/obo/CL_0007004> <http://purl.obolibrary.org/obo/CL_0011012>)
